{
  "enableSkillCommands": true,
  "extensions": [
    "./extensions/trellis/index.ts"
  ],
  "prompts": [
    "./prompts"
  ],
  "subagents": {
    "agentOverrides": {
      "trellis-implement": {
        "model": "pc-deepseek/deepseek-flash",
        "thinking": "high",
        "fallbackModels": [
          "pc-claude/claude-sonnet-5",
          "pc-glm/glm-5.3-flash",
          "ak-gpt/gpt-5.6-terra"
        ]
      },
      "trellis-check": {
        "model": "pc-grok/grok-4.6",
        "thinking": "medium",
        "fallbackModels": [
          "ak-gpt/gpt-5.6-terra",
          "ak-claude/claude-sonnet-5"
        ]
      },
      "trellis-research": {
        "model": "pc-deepseek/deepseek-flash",
        "thinking": "low",
        "fallbackModels": [
          "DeepSeek/deepseek-flash"
        ]
      }
    }
  }
}
