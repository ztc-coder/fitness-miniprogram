<view class="page theme-{{theme}}">
  <view class="profile">
    <view class="avatar">训</view>
    <view class="profile-info">
      <view class="profile-name">训练者</view>
      <view class="profile-sub">专注你的每一次渐进超负荷</view>
    </view>
    <button class="login-pill" bindtap="onShowLoginInfo" aria-label="查看登录状态">
      <text class="login-dot {{openid ? '' : 'login-pending'}}"></text>
      <text>{{openid ? '云服务已启用' : '仅本地 / 待重试'}}</text>
      <text class="setting-chevron">›</text>
    </button>
  </view>

  <view class="section-kicker">本月训练</view>
  <view class="month-card">
    <view class="month-ring" style="background: conic-gradient(var(--signal) 0% {{monthProgress}}%, var(--line-strong) {{monthProgress}}% 100%);" aria-label="本月训练 {{monthSessions}} 场，圆环按场次除以当月天数展示">
      <view class="ring-center">
        <text class="ring-count mono">{{monthSessions}}</text>
        <text class="ring-unit">场</text>
      </view>
    </view>
    <view class="month-stats">
      <view class="month-stat">
        <view class="stat-label">本月训练场次</view>
        <view class="stat-value"><text class="mono">{{monthSessions}}</text><text class="stat-unit">场</text></view>
      </view>
      <view class="month-stat">
        <view class="stat-label">本月训练时长</view>
        <view class="stat-value"><text class="mono">{{monthHours}}</text><text class="stat-unit">小时</text></view>
      </view>
    </view>
  </view>

  <view class="section-kicker">训练偏好</view>
  <view class="setting-list">
    <view class="setting-row">
      <view class="icon-tile" aria-hidden="true">☀</view>
      <view class="setting-name">浅色模式</view>
      <view class="switch-hit">
        <switch checked="{{theme === 'light'}}" color="{{theme === 'light' ? '#C3ED42' : '#3ee6a0'}}" bindchange="onToggleTheme" aria-label="浅色模式" />
      </view>
    </view>
    <view class="setting-row">
      <view class="icon-tile icon-weight" aria-hidden="true">↔</view>
      <view class="setting-name">重量单位</view>
      <text class="setting-value mono">{{unit}}</text>
    </view>
    <view class="setting-row">
      <view class="icon-tile icon-trend" aria-hidden="true"><text></text><text></text><text></text></view>
      <view class="setting-name">默认趋势指标</view>
      <text class="setting-value">总容量</text>
    </view>
  </view>

  <view class="section-kicker">云同步</view>
  <view class="setting-list sync-card">
    <view class="setting-row">
      <view class="setting-main"><view class="setting-name">云同步</view><view class="setting-sub">仅同步到本人云端</view></view>
      <view class="switch-hit"><switch checked="{{!offlineMode}}" color="{{theme === 'light' ? '#C3ED42' : '#3ee6a0'}}" bindchange="onToggleCloudSync" aria-label="云同步" /></view>
    </view>
    <view class="sync-summary" aria-live="polite"><view class="sync-headline">{{syncHeadline}}</view><view class="setting-sub">{{syncSubtitle}}</view></view>
    <view wx:if="{{showSyncBreakdown}}">
      <view class="sync-status"><text>计划</text><text>{{syncStatus.plans.state === '待同步 / 失败' ? '待同步' : syncStatus.plans.state}}</text></view>
      <view class="sync-status"><text>训练记录</text><text>{{syncStatus.sessions.state === '待同步 / 失败' ? '待同步' : syncStatus.sessions.state}}</text></view>
    </view>
    <view wx:if="{{readFailed}}" class="sync-summary" aria-live="polite">
      <view class="setting-sub">部分云端记录未加载</view>
      <button class="sync-retry" bindtap="onReloadRecords" loading="{{readLoading}}" disabled="{{readLoading}}">重新加载</button>
    </view>
    <button wx:if="{{syncIssue && !syncProcessing}}" class="sync-retry" bindtap="onSyncDetails">查看详情</button>
    <button wx:if="{{cloudFailed}}" class="sync-retry" bindtap="onToggleOffline">重试云服务</button>
    <button wx:if="{{serviceReady && pendingCount > 0 && !syncProcessing}}" class="sync-retry" bindtap="onFlushQueue">重试同步</button>
  </view>
  <view class="section-kicker">数据管理</view>
  <view class="setting-list">
    <view class="setting-row" bindtap="onOpenDataManagement" role="button" aria-label="数据管理">
      <view class="setting-main"><view class="setting-name">数据管理</view><view class="setting-sub">本机清理、云端删除与同步帮助</view></view><text class="setting-chevron">›</text>
    </view>
  </view>

  <view class="section-kicker">关于</view>
  <view class="setting-list about-list">
    <view class="setting-row" bindtap="onOpenHelp" data-section="privacy" role="button" aria-label="隐私说明与公开支持">
      <view class="setting-name">隐私说明与公开支持</view>
      <text class="setting-chevron">›</text>
    </view>
    <view class="setting-row" bindtap="onOpenHelp" data-section="data" role="button" aria-label="数据管理指引">
      <view class="setting-name">数据管理指引</view>
      <text class="setting-chevron">›</text>
    </view>
    <view class="setting-row" bindtap="onOpenHelp" data-section="help" role="button" aria-label="使用帮助与训练安全">
      <view class="setting-name">使用帮助与训练安全</view>
      <text class="setting-chevron">›</text>
    </view>
    <view class="setting-row">
      <view class="icon-tile" aria-hidden="true">ⓘ</view>
      <view class="setting-name">当前版本</view>
      <text class="setting-value mono">MVP 0.1</text>
    </view>
  </view>
</view>
