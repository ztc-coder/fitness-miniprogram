.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

/* ===== 档案卡片 ===== */
.profile {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--signal-line);
  border-radius: 30rpx;
  box-shadow: var(--card-shadow);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  color: var(--signal);
  background: var(--signal-soft);
  border: 1rpx solid var(--signal-line);
  border-radius: 28rpx;
  box-shadow: var(--signal-glow), inset 0 0 24rpx var(--signal-soft);
  font-size: 54rpx;
  font-weight: 800;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 800;
}

.profile-sub {
  margin-top: 4rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.login-pill {
  display: inline-flex !important;
  justify-content: center;
  flex-shrink: 0;
  width: auto !important;
  min-width: 0 !important;
  margin: 0 !important;
  line-height: 1.4 !important;
  background: transparent !important;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  padding: 14rpx 0 !important;
  border: 0 !important;
  border-radius: 16rpx !important;
  color: var(--ink) !important;
  font-size: var(--t-kicker) !important;
}

.login-dot {
  width: 16rpx;
  height: 16rpx;
  box-shadow: var(--signal-glow);
  border-radius: 50%;
  background: var(--signal);
}

/* ===== Inset Grouped 设置卡片 ===== */
.setting-list {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  overflow: hidden;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  min-height: 94rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--line);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-row > .setting-name {
  flex: 1;
  min-width: 0;
}

.setting-chevron {
  flex-shrink: 0;
  color: var(--signal);
  font-size: 36rpx;
  line-height: 1;
}

.setting-main {
  flex: 1;
  min-width: 0;
}

.setting-name {
  font-size: 26rpx;
  font-weight: 700;
}

.setting-sub {
  margin-top: 2rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.setting-value {
  font-size: var(--t-meta);
  color: var(--ink-faint);
}

.setting-value.accent {
  color: var(--signal);
  font-weight: 700;
}

.setting-value.warn {
  color: var(--amber);
  font-weight: 700;
}

.login-pill::after {
  display: none !important;
}

.setting-row switch,
.setting-value {
  flex-shrink: 0;
}

.section-kicker {
  margin: 24rpx 0 12rpx;
}

.profile-sub {
  font-size: 19rpx;
  white-space: nowrap;
}

.login-pending {
  background: var(--amber);
  box-shadow: none;
}

.month-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 44rpx;
  padding: 24rpx 34rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line-strong);
  border-radius: 26rpx;
  box-shadow: var(--card-shadow);
}

.month-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 214rpx;
  height: 214rpx;
  border-radius: 50%;
  background: var(--line-strong);
  box-shadow: 0 0 28rpx var(--signal-soft);
}

.ring-center {
  width: 174rpx;
  height: 174rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--card-gradient);
  box-shadow: inset 0 0 24rpx rgba(0, 0, 0, 0.35);
}

.ring-count {
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.1;
}

.ring-unit {
  color: var(--ink-dim);
  font-size: 26rpx;
}

.month-stats {
  flex: 1;
  min-width: 0;
}

.month-stat + .month-stat {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--line-strong);
}

.stat-label {
  color: var(--ink-dim);
  font-size: 22rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.stat-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
}

.icon-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: linear-gradient(145deg, var(--surface-2), var(--signal-soft));
  color: var(--signal);
  font-size: 36rpx;
  line-height: 1;
}

.icon-weight {
  color: var(--ink);
  font-weight: 800;
}

.icon-trend {
  gap: 5rpx;
}

.icon-trend text {
  width: 7rpx;
  height: 20rpx;
  margin-top: 14rpx;
  border-radius: 3rpx;
  background: var(--signal);
}

.icon-trend text:nth-child(2) {
  height: 34rpx;
  margin-top: 0;
}

.icon-trend text:nth-child(3) {
  height: 26rpx;
  margin-top: 8rpx;
}

.switch-hit {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 88rpx;
}

.switch-hit switch {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.about-list .icon-tile {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
}

/* 精修 C：头像黑底亮绿，圆环/状态深绿；不改布局。 */
.theme-light .profile { border-color: var(--line); }
.theme-light .avatar { background: var(--ink); border-color: var(--ink); color: var(--energy); }
.theme-light .avatar,
.theme-light .month-ring,
.theme-light .ring-center { box-shadow: none; }
.theme-light .icon-tile { background: var(--surface-2); color: var(--ink-dim); }
.theme-light .icon-trend text { background: var(--ink-dim); }
.theme-light .setting-chevron { color: var(--ink-dim); }

.sync-summary { padding: 24rpx 0 16rpx; }
.sync-headline { font-size: 34rpx; font-weight: 800; }
.sync-status { display: flex; justify-content: space-between; padding: 8rpx 0; color: var(--ink-dim); font-size: 24rpx; }
.sync-card { padding-bottom: 20rpx; }
.page .sync-retry { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 16rpx 0 0; padding: 16rpx 24rpx; border: 1rpx solid var(--line-strong); border-radius: 18rpx; background: var(--surface-2); color: var(--signal); font-size: 26rpx; line-height: 1.4; }
