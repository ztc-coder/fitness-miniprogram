<view class="page">
  <!-- 训练档案检索台头部 -->
  <view class="page-header">
    <view class="page-header-top">
      <view class="page-title">动作检索台</view>
      <view class="station-status-dot"></view>
    </view>
    <view class="page-subtitle">力量训练主库 · CARDIO已过滤 · 快速加练</view>
  </view>

  <view class="search-row">
    <input
      class="search-input"
      value="{{query}}"
      placeholder="输入动作名称、部位或器械检索..."
      placeholder-class="search-placeholder"
      bindinput="onSearchInput"
    />
  </view>

  <!-- sticky 外壳 + 内层轨道：左右安全区写在轨道上，避免 scroll-view padding 不计滚动宽 -->
  <view class="filter-bar">
    <scroll-view class="filter-line" scroll-x show-scrollbar="{{false}}">
      <view class="filter-track">
        <button
          wx:for="{{filters}}"
          wx:key="key"
          class="filter-pill {{filter === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilterTap"
          hover-class="filter-pill-hover"
          hover-stay-time="80"
        >
          <text class="filter-pill-label">{{item.label}}</text>
        </button>
        <!-- 末项右侧安全垫块：保证圆角/边框/active 外环可完整滚入视口 -->
        <view class="filter-track-end" aria-hidden="true"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 训练档案卡片列表 -->
  <view class="library-list">
    <view class="library-item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="library-art-wrap">
        <view class="library-art">{{item.glyph}}</view>
      </view>
      <view class="library-main">
        <view class="library-name-row">
          <view class="library-name">{{item.name}}</view>
        </view>
        <view class="library-meta-row">
          <text class="library-tag-static">器械</text>
          <text class="library-meta">{{item.meta}}</text>
        </view>
      </view>
      <view class="library-action-col">
        <view class="library-btn-circle {{pickMode ? 'pick-active' : ''}}">
          <text class="library-btn-text">{{pickMode ? '加' : '查'}}</text>
          <view class="library-chevron"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{items.length === 0}}" class="empty-state">
      <view class="empty-glyph">?</view>
      <view class="empty-title">无匹配档案</view>
      <view class="empty-desc">请尝试其他器械标签或调整检索词</view>
    </view>
  </view>

  <view class="note-card">动作示意图由 Gym visual 提供。正式上线前需完成书面授权并保留 © Gym visual 署名。</view>

  <!-- 动作详情弹层 -->
  <view class="detail-mask" wx:if="{{detail}}" bindtap="onCloseDetail">
    <view class="detail-card" catchtap="noop">
      <view class="detail-head">
        <view class="detail-head-main">
          <view class="detail-kicker">EXERCISE DOSSIER · {{detail.equipment}}</view>
          <view class="detail-title">{{detail.name}}</view>
        </view>
        <button class="detail-close" bindtap="onCloseDetail" aria-label="关闭" hover-class="detail-close-hover">×</button>
      </view>
      <view class="detail-art-wrap">
        <view class="detail-art">{{detail.glyph}}</view>
      </view>
      <view class="detail-body">
        <view class="detail-info-row">
          <text class="detail-info-label">目标肌群</text>
          <text class="detail-info-value">{{detail.target}}</text>
        </view>
        <view class="detail-desc">
          {{detail.isBodyWeight ? '自重动作，容量按总次数统计，weight 记额外负重。' : ''}}媒体位将在获得 Gym visual 授权后接入云存储。
        </view>
      </view>
      <view class="detail-actions">
        <button class="primary-button" bindtap="onPickExercise">{{pickMode ? '确认加入本次训练' : '确认加入当前训练日'}}</button>
      </view>
    </view>
  </view>
</view>
