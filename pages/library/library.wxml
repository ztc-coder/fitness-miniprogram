<view class="page theme-{{theme}}">
  <!-- 训练档案检索台头部 -->
  <view class="page-header">
    <view class="page-header-top">
      <view class="page-title">动作检索台</view>
      <view class="station-status-dot"></view>
    </view>
    <view class="page-count" aria-label="全量动作目录 · {{resultCount}} 条">{{resultCount}} 动作</view>
  </view>

  <view class="search-row">
    <view class="search-icon" aria-hidden="true"></view>
    <input
      class="search-input"
      value="{{query}}"
      placeholder="搜索动作名称、目标肌群或器械..."
      placeholder-class="search-placeholder"
      bindinput="onSearchInput"
    />
    <!-- 清空图标只在关键词非空时出现;catchtap 不冒泡到列表/卡片 -->
    <view
      wx:if="{{query}}"
      class="search-clear"
      catchtap="onClearSearch"
      hover-class="search-clear-hover"
      aria-label="清空检索词"
    >
      <text class="search-clear-glyph">×</text>
    </view>
  </view>

  <!-- sticky 外壳 + 内层轨道：左右安全区写在轨道上，避免 scroll-view padding 不计滚动宽 -->
  <view class="filter-bar">
    <scroll-view class="filter-line" scroll-x show-scrollbar="{{false}}">
      <view class="filter-track">
        <view
          wx:for="{{equipmentFilters}}"
          wx:key="key"
          class="filter-pill {{item.active ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onEquipFilterTap"
          hover-class="filter-pill-hover"
          hover-stay-time="80"
        >
          <text class="filter-pill-label">{{item.key === '全部' ? '全部器械' : item.label}}</text>
        </view>
        <!-- 末项右侧安全垫块：保证圆角/边框/active 外环可完整滚入视口 -->
        <view class="filter-track-end" aria-hidden="true"></view>
      </view>
    </scroll-view>
    <scroll-view class="filter-line" scroll-x show-scrollbar="{{false}}">
      <view class="filter-track">
        <view
          wx:for="{{bodyPartFilters}}"
          wx:key="key"
          class="filter-pill {{item.active ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onBodyPartFilterTap"
          hover-class="filter-pill-hover"
          hover-stay-time="80"
        >
          <text class="filter-pill-label">{{item.key === '全部' ? '全部部位' : item.label}}</text>
        </view>
        <view class="filter-track-end" aria-hidden="true"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 训练档案卡片列表 -->
  <view class="library-list">
    <view class="library-item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="library-art-wrap {{item.thumbSrc ? 'has-media' : ''}}">
        <image
          wx:if="{{item.thumbSrc}}"
          class="library-art library-art-image"
          src="{{item.thumbSrc}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="onThumbError"
          data-id="{{item.id}}"
        />
        <view wx:else class="library-art">{{item.glyph}}</view>
      </view>
      <view class="library-main">
        <view class="library-name-row">
          <view class="library-name">{{item.name}}</view>
        </view>
        <view class="library-meta-row">
          <text class="library-tag-static">{{item.equipmentText}}</text>
          <text class="library-meta">{{item.muscleText}}</text>
        </view>
      </view>
      <view class="library-action-col">
        <!-- 独立快捷按钮:不打开详情,直接加入训练日/训练草稿 -->
        <view
          class="library-quick-btn"
          data-id="{{item.id}}"
          catchtap="onQuickAdd"
          hover-class="library-quick-btn-hover"
          aria-label="快捷加入"
        >
          <text class="library-quick-glyph">+</text>
        </view>
        <view class="library-btn-circle {{pickMode ? 'pick-active' : ''}}">
          <text class="library-btn-text">{{pickMode ? '加' : '查'}}</text>
          <view class="library-chevron"></view>
        </view>
      </view>
    </view>

    <!-- 隐藏但仍可加载的有界预热:当前页 + 下一页,最多 48 张 JPEG,不含 GIF -->
    <view class="library-preheat" aria-hidden="true">
      <image
        wx:for="{{preheatItems}}"
        wx:if="{{item.thumbSrc}}"
        wx:key="id"
        class="library-preheat-image"
        src="{{item.thumbSrc}}"
        mode="aspectFill"
        binderror="onThumbError"
        data-id="{{item.id}}"
      />
    </view>

    <view wx:if="{{items.length === 0}}" class="empty-state">
      <view class="empty-glyph">?</view>
      <view class="empty-title">无匹配档案</view>
      <view class="empty-desc">请尝试其他器械、部位或检索词</view>
    </view>
  </view>

  <view wx:if="{{pickMode}}" class="library-hint">点击卡片查看动作图解，点击 ＋ 快速加入本次训练</view>
  <view wx:else class="library-hint">点击卡片查看动作图解，点击 ＋ 快速加入计划</view>

  <view class="note-card">动作示意图由 Gym visual 提供。正式上线前需完成书面授权并保留 © Gym visual 署名。</view>

  <!-- 普通浏览快捷加入:选择计划/训练日(可滚动) -->
  <view wx:if="{{pickerVisible}}" class="picker-mask" bindtap="onClosePicker" catchtouchmove="noop">
    <view class="picker-card" catchtap="noop">
      <view class="picker-head">
        <view class="picker-title">选择训练日</view>
        <button class="picker-close" bindtap="onClosePicker" aria-label="关闭" hover-class="picker-close-hover">×</button>
      </view>
      <scroll-view class="picker-plan-line" scroll-x show-scrollbar="{{false}}">
        <view class="picker-plan-track">
          <view
            wx:for="{{pickerPlans}}"
            wx:key="id"
            class="picker-plan-pill {{item.id === pickerPlanId ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onPickerPlanTap"
            hover-class="picker-plan-hover"
          >
            <text class="picker-plan-label">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
      <scroll-view class="picker-day-scroll" scroll-y>
        <view
          wx:for="{{pickerDays}}"
          wx:key="dayId"
          class="picker-day {{pickerSaving ? 'is-saving' : ''}}"
          data-dayid="{{item.dayId}}"
          bindtap="onPickerDayTap"
          hover-class="picker-day-hover"
        >
          <text class="picker-day-name">{{item.name}}</text>
          <text class="picker-day-meta">{{item.meta}}</text>
        </view>
        <view wx:if="{{pickerDays.length === 0}}" class="picker-empty">该计划还没有训练日</view>
      </scroll-view>
    </view>
  </view>

  <!-- 动作详情弹层(组件,打卡页复用) -->
  <exercise-detail
    theme="{{theme}}"
    wx:if="{{detail}}"
    detail="{{detail}}"
    show-pick="{{true}}"
    pick-text="{{pickMode ? '确认加入本次训练' : '确认加入当前训练日'}}"
    bind:close="onCloseDetail"
    bind:pick="onPickExercise"
  />
</view>
