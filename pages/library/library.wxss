/* ============================================================
   动作检索台 — 对齐全站 FORGE 深色
   深墨绿底 + 清晰绿色选中态 + 安静的目录列表
   签名：横向器械索引轨（工具条感）
   ============================================================ */

.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 检索台头部 ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.page-header-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
  line-height: 1.12;
  color: var(--ink);
}

.station-status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 4rpx;
  background: var(--signal);
  border-radius: 50%;
  box-shadow: var(--signal-glow);
}

.page-count {
  flex-shrink: 0;
  font-size: var(--t-meta);
  color: var(--ink-dim);
  line-height: 1.4;
  letter-spacing: 0.04em;
}

/* ===== 搜索栏 ===== */
.search-row {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.search-input {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  /* 右侧给清空图标留出触控区,文字不压在图标下 */
  padding: 0 84rpx 0 28rpx;
  text-indent: 40rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  font-size: var(--t-body);
  color: var(--ink);
  box-sizing: border-box;
}

.search-input:focus {
  border-color: var(--signal);
  box-shadow: var(--signal-glow);
}

.search-placeholder {
  color: var(--ink-faint);
  font-size: var(--t-body);
}

/* 清空图标:叠在输入框右内侧,仅关键词非空时渲染 */
.search-clear {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-clear-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 50%;
  color: var(--ink-dim);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  pointer-events: none;
}

.search-clear-hover {
  opacity: 0.6;
}

/* ===== 器械索引轨（sticky 外壳 + 横向 scroll + 内层轨道）=====
   根因：scroll-view 自身 padding / 末项 margin-right 常不计入可滚动宽度，
   导致最右 pill 圆角/边框被视口右缘裁切。
   做法：scroll-view 只做视口；filter-track 作为可滚动内容承载左右安全区。
*/
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: 12rpx -32rpx 16rpx;
  padding: 0;
  background: var(--bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-sizing: border-box;
}

/* 保留轨道安全区，筛选胶囊不加额外分隔线。 */


/* 视口：不设 enable-flex、不设左右 padding（padding 不进滚动宽） */
.filter-line {
  width: 100%;
  height: auto;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 可滚动内容轨：inline-flex 按子项撑开宽度；左右 padding 计入滚动区 */
.filter-track {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  /* 上/下：给 active 外环留空；左：页边对齐；右：末项安全区（含 active 外环） */
  padding: 12rpx 40rpx 12rpx 32rpx;
  box-sizing: border-box;
  vertical-align: top;
}

/* 末项额外安全垫块：滚动极限时仍露出完整圆角与边框 */
.filter-track-end {
  flex-shrink: 0;
  width: 24rpx;
  height: 64rpx;
  pointer-events: none;
}

/* ===== filter pill：彻底覆盖 button 默认 ===== */
.filter-pill {
  position: relative;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  /* 覆盖微信 button 默认 min-height / line-height / padding */
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  height: 64rpx !important;
  min-height: 64rpx !important;
  max-height: 64rpx !important;
  margin: 0 12rpx 0 0 !important;
  padding: 0 28rpx !important;
  line-height: 1 !important;
  font-size: 24rpx !important;
  font-weight: 600;
  color: var(--ink-dim) !important;
  background: var(--surface) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 999rpx !important;
  box-sizing: border-box !important;
  overflow: visible;
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

/* 胶囊外观 64rpx，透明上下扩展至 88rpx 热区。 */
.filter-pill::before {
  content: '';
  position: absolute;
  inset: -12rpx 0;
}

.filter-pill::after {
  display: none !important;
  border: none !important;
}

/* 末 pill 不再依赖 margin-right 充当滚动尾距（常被裁/忽略） */
.filter-track .filter-pill:last-of-type {
  margin-right: 0 !important;
}

.filter-pill-label {
  line-height: 1;
  font-size: 24rpx;
  font-weight: inherit;
  color: inherit;
  pointer-events: none;
}

/* 多选选中态：绿色实底与柔和辉光 */
.filter-pill.active {
  color: var(--signal-ink) !important;
  background: var(--signal-gradient) !important;
  border-color: var(--signal) !important;
  font-weight: 800;
  box-shadow: var(--signal-glow);
}

.filter-pill.active .filter-pill-label {
  font-weight: 800;
}

/* 轻点反馈（不用 :active 改尺寸，避免 reflow 裁切） */
.filter-pill-hover {
  opacity: 0.82;
}

/* ===== 动作卡片列表 ===== */
.library-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.library-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  min-height: 174rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 30rpx;
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
  transition: background 0.12s ease, transform 0.12s ease;
}

.library-item:active {
  background: var(--surface-2);
  transform: scale(0.992);
}

/* 器械首字徽标 */
.library-art-wrap {
  flex-shrink: 0;
  background: var(--thumb-gradient);
  border-radius: 22rpx;
  overflow: hidden;
}

.library-art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background: var(--thumb-gradient);
  border: 1rpx solid var(--signal-line);
  border-radius: 22rpx;
  color: var(--signal-ink);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
  line-height: 1;
  box-sizing: border-box;
  overflow: hidden;
}

.library-art-image {
  display: block;
  background: transparent;
  mix-blend-mode: multiply;
  border-color: transparent;
}

/* 预热图不占布局,只负责让当前页与下一页 JPEG 提前进入缓存。 */
.library-preheat {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.library-preheat-image {
  width: 1rpx;
  height: 1rpx;
}

.library-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.library-name-row {
  display: flex;
  align-items: center;
}

.library-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.library-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  min-width: 0;
}

.library-tag-static {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-dim);
  background: transparent;
  padding: 4rpx 10rpx;
  border: 1rpx solid var(--signal-line);
  border-radius: 8rpx;
  letter-spacing: 0;
  line-height: 1.2;
}

.library-meta {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--ink-dim);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧触控操作区 */
.library-action-col {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 0;
}

/* 快捷加入:独立图标按钮,不打开详情 */
.library-quick-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--signal-soft);
  border: 1rpx solid var(--signal-line);
  box-sizing: border-box;
  transition: opacity 0.15s ease, transform 0.12s ease;
}

.library-quick-glyph {
  color: var(--signal);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  pointer-events: none;
}

.library-quick-btn-hover {
  opacity: 0.86;
  transform: scale(0.96);
}

.library-btn-circle {
  display: none;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 76rpx;
  min-height: 24rpx;
  border-radius: 8rpx;
  background: transparent;
  border: 0;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.library-item:active .library-btn-circle {
  border-color: var(--signal);
  background: var(--signal-soft);
}

.library-btn-text {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1;
}

.library-item:active .library-btn-text {
  color: var(--signal);
}

.library-chevron {
  width: 10rpx;
  height: 10rpx;
  margin-left: 2rpx;
  border-top: 3rpx solid var(--ink-dim);
  border-right: 3rpx solid var(--ink-dim);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.library-item:active .library-chevron {
  border-color: var(--signal);
}

/* pick 模式：信号绿加练 */
.library-btn-circle.pick-active {
  display: flex;
  background: var(--signal);
  border-color: var(--signal);
  box-shadow: var(--signal-glow);
}

.library-btn-circle.pick-active .library-btn-text {
  color: var(--signal-ink);
}

.library-btn-circle.pick-active .library-chevron {
  border-color: var(--signal-ink);
}

/* ===== 训练日选择弹层(普通浏览快捷加入) =====
   卡片取确定高度:内层 scroll-view 才能拿到确定高度并原生滚动。 */
.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.68);
  box-sizing: border-box;
}

.picker-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640rpx;
  height: 62vh;
  max-height: calc(100vh - 72rpx - env(safe-area-inset-bottom));
  background: var(--card-gradient);
  border-radius: 32rpx;
  border: 1rpx solid var(--line-strong);
  box-shadow: 0 24rpx 60rpx -24rpx rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
  overflow: hidden;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 26rpx 28rpx 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.picker-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.picker-close {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 88rpx !important;
  height: 88rpx !important;
  min-width: 88rpx !important;
  max-width: 88rpx !important;
  min-height: 88rpx !important;
  max-height: 88rpx !important;
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 !important;
  color: var(--ink-dim) !important;
  background: var(--surface-2) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 50% !important;
  font-size: 32rpx !important;
  line-height: 1 !important;
  box-sizing: border-box !important;
}

.picker-close::after {
  display: none !important;
  border: none !important;
}

.picker-close-hover {
  opacity: 0.75;
}

/* 计划行:横向滚动,多计划时切换 */
.picker-plan-line {
  flex-shrink: 0;
  width: 100%;
  height: auto;
  white-space: nowrap;
  padding: 18rpx 0 0;
  box-sizing: border-box;
}

.picker-plan-track {
  display: inline-flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  vertical-align: top;
}

.picker-plan-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 88rpx;
  margin-right: 12rpx;
  padding: 0 26rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.picker-plan-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-dim);
  line-height: 1;
  pointer-events: none;
}

.picker-plan-pill.active {
  background: var(--signal-gradient);
  border-color: var(--signal);
  box-shadow: var(--signal-glow);
}

.picker-plan-pill.active .picker-plan-label {
  color: var(--signal-ink);
  font-weight: 800;
}

.picker-plan-hover {
  opacity: 0.82;
}

/* 训练日列表:吃满剩余高度,原生滚动 */
.picker-day-scroll {
  flex: 1 1 0%;
  height: 0;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.picker-day {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 20rpx 12rpx;
  padding: 24rpx 24rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  box-sizing: border-box;
}

.picker-day-hover {
  background: var(--signal-soft);
  border-color: var(--signal);
}

.picker-day.is-saving {
  opacity: 0.55;
  pointer-events: none;
}

.picker-day-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-day-meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-dim);
}

.picker-empty {
  padding: 40rpx 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ===== 提示卡片(沿用全局 note 语义,本页略收紧) ===== */
.note-card {
  margin-top: 8rpx;
  padding: 22rpx 24rpx;
  color: var(--ink-dim);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  font-size: var(--t-kicker);
  line-height: 1.6;
  box-sizing: border-box;
}


/* 放大镜为纯装饰，输入框的清空触控区与原 padding 契约不变。 */
.search-icon {
  position: absolute;
  left: 26rpx;
  top: 29rpx;
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid var(--ink-dim);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 2rpx;
  background: var(--ink-dim);
  transform: rotate(48deg);
}

/* 操作提示与版权信息分层，训练中不暗示会写入计划。 */
.library-hint {
  margin: 8rpx 0 24rpx;
  color: var(--ink-dim);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}
