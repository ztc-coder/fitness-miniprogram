<view class="page">
  <view class="date-row">
    <text class="date-line">{{dateLine}}</text>
    <text class="status-pill {{pendingCount > 0 ? 'pending' : ''}}">{{pendingCount > 0 ? '待提交 ' + pendingCount : (day ? '训练日' : '今天')}}</text>
  </view>

  <block wx:if="{{day}}">
    <view class="day-line">
      <view class="day-heading">
        <view class="day-name">{{day.name}}</view>
        <view class="plan-name">{{plan.name}}</view>
      </view>
      <view class="day-mark"><text>DAY</text><text class="day-number mono">{{dayNum}}</text></view>
    </view>
    <view class="home-caption">
      <text><text class="caption-number mono">{{exerciseCount}}</text> 个动作</text>
      <text><text class="caption-number mono">{{totalSets}}</text> 组训练</text>
      <text>第 {{dayNum * 1}} / {{dayTotal * 1}} 天</text>
    </view>
  </block>

  <!-- 草稿是独立场次：无当前计划时也保留恢复入口。 -->
  <view wx:if="{{hasDraft}}" class="resume-card">
    <view class="resume-head">
      <view class="resume-title"><text class="live-dot">●</text>有一场训练正在进行</view>
      <text class="draft-progress mono">{{draftInfo.completed}} / {{draftInfo.total}} 组</text>
    </view>
    <view class="resume-meta">{{draftInfo.planName}} · {{draftInfo.dayName}}</view>
    <button class="action-button" bindtap="onResumeDraft" disabled="{{starting}}" hover-class="cta-press">继续训练 <text class="button-arrow">→</text></button>
    <button wx:if="{{day}}" class="new-training" bindtap="onStartTraining" disabled="{{starting}}" hover-class="cta-press">按当前计划开始新训练</button>
  </view>
  <button wx:elif="{{day}}" class="action-button start-button" bindtap="onStartTraining" disabled="{{starting}}" hover-class="cta-press">开始训练 <text class="button-arrow">→</text></button>

  <block wx:if="{{day}}">
    <view class="section-head"><text class="section-title">今天练这些</text><text class="section-note">按你的节奏</text></view>
    <view class="exercise-list">
      <view class="exercise-row" wx:for="{{exercises}}" wx:key="index">
        <view class="exercise-thumb">
          <image wx:if="{{item.imageSrc}}" src="{{item.imageSrc}}" mode="aspectFit" data-index="{{index}}" binderror="onImageError" class="exercise-image" />
          <text wx:else class="exercise-glyph" aria-hidden="true">↔</text>
        </view>
        <view class="exercise-main"><view class="exercise-name">{{item.name}}</view><view class="exercise-note">{{item.note}}</view></view>
        <text class="exercise-target mono">{{item.prescription}}</text>
      </view>
    </view>
    <view class="media-credit">© Gym visual</view>
    <view class="next-day">完成本次训练后，进入{{nextDayName}}。</view>
  </block>
  <view wx:else class="empty-state">
    <view class="empty-title">还没有训练计划</view>
    <view class="empty-desc">创建一个循环计划，今天该练什么一目了然</view>
    <button class="action-button" bindtap="onGoPlan" hover-class="cta-press">去创建计划</button>
  </view>
</view>
