/* ============================================================
   今天页 — TODAY BOARD
   晴空青黄：薄荷纸底 + 青色行动 + 琥珀游标
   签名：巨型描边 DAY 数字（全站仅此）
   结构：角标 / 刻度 / 分区线；循环点轨 = 进度；01 02 = 动作序
   禁止：orb / bokeh / 漂浮光球 / 硬边大框舞台
   ============================================================ */

.page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 顶栏 ===== */
.page-header {
  margin-bottom: 10rpx;
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.topline-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.topline-kicker {
  font-size: var(--t-kicker);
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--ink-faint);
  white-space: nowrap;
}

.topline-live {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--signal);
  box-shadow: 0 0 0 6rpx rgba(22, 191, 174, 0.18);
  animation: pulse-dot 2s infinite ease-in-out;
  flex-shrink: 0;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 0.55; transform: scale(0.92); }
  50% { opacity: 1; transform: scale(1); }
}

.date-line {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.04em;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 同步胶囊：已同步=青 / 待提交=琥珀 warn */
.sync-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid rgba(22, 191, 174, 0.28);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.sync-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--signal);
  box-shadow: 0 0 0 4rpx rgba(22, 191, 174, 0.16);
  flex-shrink: 0;
}

.sync-text {
  font-size: var(--t-kicker);
  font-weight: 700;
  color: var(--signal);
  letter-spacing: 0.04em;
  line-height: 1;
  white-space: nowrap;
}

.sync-pill.warn {
  border-color: rgba(217, 180, 40, 0.65);
  background: rgba(255, 216, 74, 0.16);
}

.sync-pill.warn .sync-dot {
  background: var(--amber);
  box-shadow: 0 0 0 4rpx rgba(255, 216, 74, 0.28);
}

.sync-pill.warn .sync-text {
  color: #9a7414;
}

/* ===== 主舞台 Hero：开放式，不进硬边大框 ===== */
.hero {
  position: relative;
  margin-top: 6rpx;
  padding: 12rpx 0 4rpx;
  overflow: hidden;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-day-block {
  position: relative;
  min-width: 0;
  flex: 1;
  padding: 16rpx 20rpx 12rpx 30rpx;
  box-sizing: border-box;
}

/* 结构化边框：四角开框 + 左侧刻度 */
.hero-day-frame {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.hero-day-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: rgba(22, 191, 174, 0.5);
  border-style: solid;
  box-sizing: border-box;
}

.hero-day-corner.tl {
  top: 0;
  left: 0;
  border-width: 2rpx 0 0 2rpx;
}

.hero-day-corner.tr {
  top: 0;
  right: 0;
  border-width: 2rpx 2rpx 0 0;
}

.hero-day-corner.bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 2rpx 2rpx;
}

.hero-day-corner.br {
  bottom: 0;
  right: 0;
  border-width: 0 2rpx 2rpx 0;
}

.hero-day-ticks {
  position: absolute;
  top: 18rpx;
  bottom: 14rpx;
  left: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.hero-day-tick {
  width: 8rpx;
  height: 2rpx;
  background: rgba(22, 191, 174, 0.26);
  border-radius: 1rpx;
}

.hero-day-tick.mid {
  width: 12rpx;
  background: rgba(22, 191, 174, 0.4);
}

.hero-day-tick.long {
  width: 16rpx;
  background: rgba(22, 191, 174, 0.55);
}

.hero-day-label {
  position: relative;
  z-index: 1;
  display: block;
  font-size: var(--t-kicker);
  font-weight: 800;
  letter-spacing: 0.32em;
  color: var(--ink-faint);
  line-height: 1.2;
}

.hero-day-rule {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 3rpx;
  margin-top: 10rpx;
  background: var(--signal);
  border-radius: 2rpx;
  opacity: 0.75;
}

.hero-day-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* 全站签名：巨型描边数字 */
.hero-day-num {
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-size: var(--t-hero);
  font-weight: 700;
  line-height: 0.88;
  color: transparent;
  -webkit-text-stroke: 3.5rpx var(--signal);
  letter-spacing: -0.04em;
}

.hero-day-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 18rpx;
  min-width: 0;
}

.hero-day-slash {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-faint);
  line-height: 1;
  margin-bottom: 2rpx;
}

.hero-day-total {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink-dim);
  line-height: 1;
}

.hero-day-unit {
  margin-top: 8rpx;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 0.18em;
  color: var(--signal);
  line-height: 1;
}

/* 琥珀游标 chip：active 语义 */
.hero-cursor-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-top: 10rpx;
  padding: 12rpx 18rpx;
  background: var(--amber);
  border-radius: 999rpx;
  box-shadow: 0 0 0 6rpx rgba(255, 216, 74, 0.22);
  box-sizing: border-box;
}

.hero-cursor-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink);
  opacity: 0.5;
  flex-shrink: 0;
}

.hero-cursor-text {
  font-size: var(--t-kicker);
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.04em;
  line-height: 1;
  white-space: nowrap;
}

/* 当前训练日：首屏内容焦点 */
.hero-name {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: 0.01em;
  color: var(--ink);
  word-break: break-word;
  max-width: 100%;
}

.hero-plan-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 16rpx;
  margin-top: 16rpx;
}

.hero-plan-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  min-width: 0;
  padding: 8rpx 14rpx 8rpx 10rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.hero-plan-badge-label {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--signal-ink);
  background: var(--signal);
  border-radius: 999rpx;
  line-height: 1.2;
}

.hero-plan-badge-name {
  min-width: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.hero-rule {
  font-size: var(--t-kicker);
  color: var(--ink-dim);
  line-height: 1.4;
  letter-spacing: 0.02em;
  flex: 1 1 200rpx;
  min-width: 0;
}

/* ===== 主操作：紧随训练日，首屏行动终点 ===== */
.cta-wrap {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.cta-wrap.resume .start-btn {
  box-shadow: 0 0 0 8rpx rgba(255, 216, 74, 0.22);
}

.start-btn {
  width: 100% !important;
  min-height: 108rpx !important;
  font-size: 32rpx !important;
  letter-spacing: 0.14em !important;
  border-radius: 999rpx !important;
}

.cta-hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: var(--t-kicker);
  color: var(--ink-dim);
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.cta-press {
  opacity: 0.85;
}

/* ===== 循环进度轨：浅色结构面 ===== */
.cycle-rail {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  box-sizing: border-box;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.cycle-rail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.cycle-rail-label {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: var(--ink-faint);
}

.cycle-rail-hint {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--ink-dim);
}

.cycle-dots {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 28rpx;
}

.cycle-dot-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cycle-dot-wrap:last-child {
  flex: 0 0 auto;
}

.cycle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  background: transparent;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.cycle-dot.done {
  background: var(--signal);
  border-color: var(--signal);
}

.cycle-dot.current {
  width: 20rpx;
  height: 20rpx;
  background: var(--amber);
  border-color: rgba(217, 180, 40, 0.95);
  box-shadow: 0 0 0 8rpx rgba(255, 216, 74, 0.28);
}

.cycle-seg {
  flex: 1;
  height: 3rpx;
  margin: 0 8rpx;
  background: var(--line);
  border-radius: 2rpx;
  min-width: 12rpx;
}

.cycle-seg.done {
  background: linear-gradient(90deg, var(--signal), rgba(22, 191, 174, 0.5));
}

/* ===== 指标轨：一体仪表，非三张卡 ===== */
.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
  padding: 22rpx 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 28rpx -18rpx rgba(21, 59, 58, 0.12);
  box-sizing: border-box;
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 0 8rpx;
}

.hero-stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1;
}

.hero-stat-label {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--ink-faint);
  line-height: 1.2;
  white-space: nowrap;
}

.hero-stat-divider {
  width: 1rpx;
  align-self: stretch;
  margin: 4rpx 0;
  background: var(--line);
  flex-shrink: 0;
}

/* ===== 动作清单：序号徽标 + 处方右对齐 ===== */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 8rpx;
  margin-bottom: 12rpx;
}

.exercise-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  padding: 20rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.exercise-index-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: rgba(22, 191, 174, 0.1);
  border: 1rpx solid rgba(22, 191, 174, 0.22);
  box-sizing: border-box;
}

.exercise-index {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--signal);
  line-height: 1;
  letter-spacing: 0.02em;
}

.exercise-main {
  flex: 1;
  min-width: 0;
}

.exercise-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exercise-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exercise-target-wrap {
  flex-shrink: 0;
  max-width: 38%;
  display: flex;
  justify-content: flex-end;
}

.exercise-target {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--signal);
  line-height: 1.25;
  text-align: right;
  word-break: break-all;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 36rpx 80rpx;
  text-align: center;
}

.empty-state .empty-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 148rpx;
  border: 2rpx dashed rgba(22, 191, 174, 0.4);
  border-radius: 50%;
  font-size: 56rpx;
  color: var(--signal);
  line-height: 1;
  background: rgba(22, 191, 174, 0.06);
  box-shadow: 0 0 0 12rpx rgba(22, 191, 174, 0.05);
}

.empty-state .empty-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.empty-state .empty-desc {
  margin-top: 12rpx;
  max-width: 480rpx;
  font-size: var(--t-meta);
  color: var(--ink-dim);
  line-height: 1.55;
}

.empty-btn {
  margin-top: 44rpx;
  width: 72% !important;
  max-width: 420rpx;
  min-height: 96rpx !important;
  letter-spacing: 0.1em;
  border-radius: 999rpx !important;
}

/* 微信 button 宽度兜底 */
button.primary-button {
  width: 100% !important;
  box-sizing: border-box !important;
}

button.primary-button::after {
  border: none !important;
}
