/* 今天页 FORGE 布局，与全局深色主题一致。 */
page {
  --bg: #0c1613;
  --surface: #14211c;
  --surface-2: #24382e;
  --line: #2a3b32;
  --ink: #eef5f1;
  --ink-dim: #a2b5aa;
  --ink-faint: #96aa9d;
  --signal: #3ddc97;
  --signal-ink: #092518;
  --amber: #ffb020;
  background: var(--bg);
  color: var(--ink);
}

.page { min-height: 100vh; padding: 18rpx 42rpx calc(48rpx + env(safe-area-inset-bottom)); background: var(--bg); }
.date-row, .day-line, .resume-head, .section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.date-line { font-size: 24rpx; color: var(--ink-dim); }
.status-pill { flex-shrink: 0; padding: 8rpx 20rpx; border-radius: 40rpx; background: #23352c; color: var(--signal); font-size: 20rpx; }
.status-pill.pending { color: var(--amber); }
.day-line { margin-top: 48rpx; align-items: flex-start; }
.day-heading { flex: 1; min-width: 0; }
.day-name { font-size: 68rpx; font-weight: 700; line-height: 1.2; letter-spacing: -2rpx; overflow-wrap: break-word; }
.plan-name { margin-top: 18rpx; font-size: 28rpx; color: var(--ink-dim); overflow-wrap: break-word; }
.day-mark { flex-shrink: 0; text-align: right; color: #a7bcaf; font-size: 22rpx; letter-spacing: 2rpx; line-height: 1.4; }
.day-number { display: block; font-size: 90rpx; font-weight: 500; line-height: 1; letter-spacing: -6rpx; color: #547c66; }
.home-caption { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin: 28rpx 0 46rpx; font-size: 24rpx; color: var(--ink-dim); }
.caption-number { color: var(--ink); font-size: 30rpx; }
.resume-card { background: #182d22; border: 1rpx solid #2d4a38; border-radius: 38rpx; padding: 34rpx; margin-bottom: 52rpx; }
.resume-head { flex-wrap: wrap; gap: 10rpx 16rpx; }
.resume-title { font-size: 26rpx; font-weight: 600; }
.live-dot { font-size: 20rpx; color: var(--signal); margin-right: 10rpx; }
.draft-progress { font-size: 24rpx; color: var(--signal); white-space: nowrap; }
.resume-meta { margin: 14rpx 0 30rpx; font-size: 24rpx; color: #b0c7b8; overflow-wrap: break-word; }
.page .action-button { width: 100%; min-width: 0; margin: 0; padding: 18rpx 24rpx; line-height: 1.4; min-height: 100rpx; border-radius: 28rpx; background: var(--signal); color: var(--signal-ink); font-size: 30rpx; font-weight: 650; display: flex; align-items: center; justify-content: center; gap: 18rpx; }
.action-button[disabled], .new-training[disabled] { opacity: .4; }
.button-arrow { font-size: 36rpx; font-weight: 400; }
.page .new-training { width: 100%; min-width: 0; min-height: 84rpx; padding: 0; line-height: 1.4; margin: 8rpx 0 -12rpx; color: var(--ink-dim); font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.page .start-button { margin-bottom: 52rpx; }
.cta-press { opacity: .85; }
.section-title { font-size: 32rpx; font-weight: 650; }
.section-note { color: var(--ink-dim); font-size: 22rpx; }
.exercise-row { display: flex; align-items: center; gap: 24rpx; padding: 34rpx 0; border-bottom: 1rpx solid var(--line); }
.exercise-thumb { width: 92rpx; height: 92rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 22rpx; background: var(--surface-2); color: #b0c6b8; }
.exercise-image { width: 100%; height: 100%; }
.exercise-glyph { font-size: 54rpx; }
.exercise-main { flex: 1; min-width: 0; }
.exercise-name { font-size: 28rpx; font-weight: 600; line-height: 1.4; overflow-wrap: break-word; }
.exercise-note { margin-top: 8rpx; font-size: 22rpx; color: var(--ink-dim); line-height: 1.4; }
.exercise-target { flex-shrink: 0; font-size: 22rpx; color: #c0d0c6; white-space: nowrap; }
.media-credit, .next-day { font-size: 20rpx; color: var(--ink-faint); margin-top: 20rpx; }
.empty-state { padding: 64rpx 0; }
.empty-title { font-size: 36rpx; font-weight: 650; }
.empty-desc { margin: 16rpx 0 36rpx; font-size: 26rpx; color: var(--ink-dim); }
@media (max-width: 359px) {
  .page { padding-left: 30rpx; padding-right: 30rpx; }
  .day-name { font-size: 60rpx; }
  .exercise-row { gap: 18rpx; }
  .resume-card { padding: 28rpx; }
}
