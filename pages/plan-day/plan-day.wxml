<view class="page">
  <view class="page-title">{{dayName}} · 训练日</view>
  <view class="page-subtitle">设置每个动作的组数、次数和重量，训练时可逐组调整</view>

  <view class="section-kicker">动作列表</view>
  <view class="exercise-list" wx:if="{{exercises.length > 0}}">
    <view class="exercise-row" wx:for="{{exercises}}" wx:key="exerciseId">
      <view class="exercise-main">
        <view class="exercise-name">{{item.name}}</view>
        <view class="exercise-target">{{item.prescription}}</view>
      </view>
      <view class="exercise-tools">
        <button class="tool-btn" catchtap="onMove" data-index="{{item.index}}" data-dir="up" disabled="{{item.isFirst}}">↑</button>
        <button class="tool-btn" catchtap="onMove" data-index="{{item.index}}" data-dir="down" disabled="{{item.isLast}}">↓</button>
        <button class="tool-btn" catchtap="onEditTarget" data-index="{{item.index}}">改</button>
        <button class="tool-btn danger" catchtap="onRemove" data-index="{{item.index}}">删</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state">
    <text class="empty-glyph">◔</text>
    <view class="empty-title">这个训练日还没有动作</view>
    <view class="empty-desc">从动作库挑选动作加入</view>
  </view>

  <button class="primary-button add-btn" bindtap="onAddExercise">＋ 从动作库添加</button>
</view>
