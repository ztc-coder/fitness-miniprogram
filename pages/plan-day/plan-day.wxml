<view class="page theme-{{theme}}">
  <view class="day-kicker">{{kicker}}</view>
  <view class="page-title">{{dayName}}</view>
  <view class="page-subtitle">调整动作顺序、组数、次数与重量</view>

  <view class="section-heading">
    <view class="section-kicker">动作顺序 ({{exercises.length}})</view>
    <text class="order-hint">使用 ↑ ↓ 调整顺序</text>
  </view>
  <view class="exercise-list" wx:if="{{exercises.length > 0}}">
    <view class="exercise-row" wx:for="{{exercises}}" wx:key="index">
      <view class="exercise-grip" aria-hidden="true">
        <view></view><view></view><view></view>
        <view></view><view></view><view></view>
      </view>
      <view class="exercise-thumb {{item.imageSrc ? 'has-media' : ''}}" aria-hidden="true">
        <image wx:if="{{item.imageSrc}}" src="{{item.imageSrc}}" mode="aspectFit" binderror="onImageError" data-index="{{item.index}}" />
        <view wx:else class="thumb-glyph"><view></view></view>
      </view>
      <view class="exercise-main">
        <view class="exercise-name">{{item.name}}</view>
        <view class="exercise-tags">
          <text wx:if="{{item.bodyPartLabel}}">{{item.bodyPartLabel}}</text>
          <text wx:if="{{item.equipmentLabel}}">{{item.equipmentLabel}}</text>
        </view>
        <button class="exercise-target" bindtap="onEditTarget" data-index="{{item.index}}" aria-label="编辑{{item.name}}目标：{{item.prescription}}">
          <text class="target-capsule">{{item.prescription}} <text aria-hidden="true">✎</text></text>
        </button>
      </view>
      <button class="tool-btn remove-btn" catchtap="onRemove" data-index="{{item.index}}" aria-label="移除{{item.name}}"><text>✕</text></button>
      <view class="exercise-tools">
        <button class="tool-btn" catchtap="onMove" data-index="{{item.index}}" data-dir="up" disabled="{{item.isFirst}}" aria-label="上移{{item.name}}"><text>↑</text></button>
        <button class="tool-btn" catchtap="onMove" data-index="{{item.index}}" data-dir="down" disabled="{{item.isLast}}" aria-label="下移{{item.name}}"><text>↓</text></button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state">
    <text class="empty-glyph">◔</text>
    <view class="empty-title">这个训练日还没有动作</view>
    <view class="empty-desc">从动作库挑选动作加入</view>
  </view>

  <button class="primary-button add-btn" bindtap="onAddExercise">＋ 从动作库添加动作</button>
  <view wx:if="{{exercises.length > 0}}" class="image-credit">© Gym visual</view>
</view>
