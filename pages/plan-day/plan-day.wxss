.page {
  min-height: 100vh;
  padding: 30rpx 32rpx 48rpx;
  background: var(--bg);
}

/* ===== 动作列表:卡片化设计 ===== */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.exercise-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.exercise-main {
  flex: 1;
  min-width: 0;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.exercise-target {
  margin-top: 8rpx;
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--signal);
  line-height: 1.2;
}

.exercise-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 强制重置微信小程序默认 button 样式，避免默认宽度/内边距挤压布局 */
.tool-btn {
  box-sizing: border-box !important;
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  min-height: 64rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  border: none !important;
  background: var(--surface-2) !important;
  color: var(--ink-dim) !important;
  border-radius: 12rpx !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  font-size: 28rpx !important;
  font-weight: 700 !important;
}

.tool-btn::after {
  display: none !important;
}

.tool-btn:active {
  opacity: 0.72;
  transform: scale(0.95);
}

.tool-btn[disabled] {
  opacity: 0.25 !important;
  background: var(--surface-2) !important;
  color: var(--ink-faint) !important;
}

.tool-btn.danger {
  background: rgba(229, 83, 61, 0.08) !important;
  color: var(--danger) !important;
}

/* ===== 确保全局按钮宽度不被微信 184px 限制且支持弹性伸缩 ===== */
button.primary-button {
  width: 100% !important;
}

.add-btn {
  margin-top: 40rpx;
}
