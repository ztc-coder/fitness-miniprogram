.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

/* ===== 动作列表:卡片化设计 ===== */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.exercise-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  flex-wrap: wrap;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.exercise-main {
  flex: 1 1 260rpx;
  min-width: 0;
}

.exercise-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.exercise-target {
  margin-top: 8rpx;
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--signal);
  line-height: 1.2;
}

.exercise-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: auto;
}

/* 强制重置微信小程序默认 button 样式，避免默认宽度/内边距挤压布局 */
.tool-btn {
  box-sizing: border-box !important;
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  min-height: 64rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  border: none !important;
  background: var(--surface-2) !important;
  color: var(--ink-dim) !important;
  border-radius: 12rpx !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  font-size: 28rpx !important;
  font-weight: 700 !important;
}

.tool-btn::after {
  display: none !important;
}

.tool-btn:active {
  opacity: 0.72;
  transform: scale(0.95);
}

.tool-btn[disabled] {
  opacity: 0.25 !important;
  background: var(--surface-2) !important;
  color: var(--ink-faint) !important;
}

.tool-btn.danger {
  background: rgba(255, 143, 124, 0.08) !important;
  color: var(--danger) !important;
}

/* ===== 确保全局按钮宽度不被微信 184px 限制且支持弹性伸缩 ===== */
button.primary-button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-width: 0 !important;
  min-height: 96rpx !important;
  margin: 40rpx 0 0 !important;
  padding: 18rpx 24rpx !important;
  line-height: 1.4 !important;
  border-radius: 28rpx !important;
  background: var(--signal) !important;
  color: var(--signal-ink) !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  letter-spacing: 0;
}

.add-btn {
  margin-top: 40rpx;
}
