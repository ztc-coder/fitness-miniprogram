/* 计划页 — FORGE 深色循环进度 */

.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 顶栏 ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.page-heading {
  flex: 1;
  min-width: 0;
}


.page-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
  line-height: 1.12;
  color: var(--ink);
}

.page-subtitle {
  margin-top: 10rpx;
  font-size: var(--t-meta);
  color: var(--ink-dim);
  line-height: 1.4;
  letter-spacing: 0.02em;
}

/* 编辑胶囊：常态线框 / 完成态 signal 实心 */
.edit-pill {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0 !important;
  height: auto !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 12rpx 28rpx !important;
  position: relative;
  line-height: 1 !important;
  color: var(--ink-dim) !important;
  background: var(--surface) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 16rpx !important;
  font-size: var(--t-kicker) !important;
  font-weight: 600 !important;
  letter-spacing: 0.08em;
  box-sizing: border-box !important;
}

.edit-pill::after {
  display: none !important;
  border: none !important;
}

.edit-pill.done {
  color: var(--signal-ink) !important;
  background: var(--signal) !important;
  border-color: var(--signal) !important;
  font-weight: 800 !important;
}

.edit-pill-hover {
  opacity: 0.82;
}

/* ===== active 计划卡 ===== */
.plan-card {
  position: relative;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--signal-line);
  border-radius: 30rpx;
  box-shadow: var(--card-shadow);
  overflow: hidden;
  box-sizing: border-box;
}


.plan-card-head {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.plan-card-info {
  flex: 1;
  min-width: 0;
}

.plan-card-kicker {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--signal);
  line-height: 1.2;
}

.plan-card-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  color: var(--ink);
  word-break: break-all;
}

.plan-card-sub {
  margin-top: 8rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
  letter-spacing: 0.02em;
}

.plan-card-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

/* 当前计划状态 */
.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  color: var(--signal-ink);
  background: var(--signal-gradient);
  box-shadow: var(--signal-glow);
  border-radius: 16rpx;
  font-size: var(--t-kicker);
  font-weight: 800;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.status-chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--signal-ink);
}

.plan-card-delete-btn {
  box-sizing: border-box !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 12rpx 24rpx !important;
  line-height: 1 !important;
  border: 1rpx solid rgba(255, 143, 124, 0.22) !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: rgba(255, 143, 124, 0.08) !important;
  color: var(--danger) !important;
  border-radius: 16rpx !important;
  font-size: var(--t-kicker) !important;
  font-weight: 700 !important;
  white-space: nowrap;
}

.plan-card-delete-btn::after {
  display: none !important;
  border: none !important;
}

/* ===== 循环轨道：本页签名 ===== */
.cycle-track {
  position: relative;
  z-index: 1;
  display: flex;
  margin: 32rpx 0 24rpx;
  padding: 8rpx 0 4rpx;
}

.cycle-cell {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.cycle-node {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-strong);
  background: var(--surface-2);
  box-sizing: border-box;
}

.cycle-num {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink-dim);
  line-height: 1;
}

/* 已完成：信号青 */
.cycle-node.done {
  background: transparent;
  border-color: var(--signal);
}

.cycle-check {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--signal);
  line-height: 1;
}

/* 当前训练日 */
.cycle-node.current {
  background: var(--signal-gradient);
  border-color: var(--signal);
  box-shadow: var(--signal-glow), 0 0 0 5rpx var(--signal-soft);
}

.cycle-node.current .cycle-num {
  color: var(--signal-ink);
}

.cycle-name {
  max-width: 100%;
  padding: 0 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-faint);
  text-align: center;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cycle-name.current {
  color: var(--ink);
  font-weight: 800;
}

.cycle-name.done {
  color: var(--signal);
}

/* 节点间连接线：以节点中心对齐 */
.cycle-link {
  position: absolute;
  top: 36rpx;
  left: calc(50% + 42rpx);
  right: calc(-50% + 42rpx);
  height: 3rpx;
  background: var(--line);
  border-radius: 2rpx;
}

.cycle-link.done {
  background: var(--signal);
}

/* NEXT 仅展示当前游标对应的待练日，不改变游标。 */
.plan-next {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: rgba(8, 17, 14, 0.35);
}

.plan-next-label {
  flex-shrink: 0;
  color: var(--signal);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.plan-next-text {
  min-width: 0;
  font-size: 22rpx;
  color: var(--ink-dim);
  line-height: 1.5;
}

.plan-next-day {
  color: var(--ink);
  font-weight: 600;
}

.section-kicker {
  margin: 28rpx 0 14rpx;
}

/* ===== 训练日列表 ===== */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 18rpx 18rpx 22rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
}

.plan-row:active {
  background: var(--surface-2);
  transform: scale(0.994);
}

.plan-row.editing:active {
  transform: none;
  background: var(--surface);
}

/* 当前训练日与循环轨道共享游标，仅以样式突出，不增加交互。 */
.plan-row.current {
  border-color: var(--signal);
  box-shadow: var(--signal-glow);
}

.plan-row.current .plan-row-index {
  background: var(--signal-gradient);
  border-color: var(--signal);
  box-shadow: var(--signal-glow);
}

.plan-row.current .plan-row-num {
  color: var(--signal-ink);
}

/* 序号：结构编码 01 02 03 */
.plan-row-index {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  box-sizing: border-box;
}

.plan-row-num {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--signal);
  line-height: 1;
  letter-spacing: 0.02em;
}

.plan-row-main {
  flex: 1;
  min-width: 0;
}

.plan-row-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.today-tag {
  font-size: 20rpx;
  color: var(--signal);
  white-space: nowrap;
}

.plan-row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 72rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  background: linear-gradient(145deg, var(--surface-2), var(--signal-soft));
  color: #b9f3d8;
}

.day-barbell {
  position: relative;
  width: 40rpx;
  height: 5rpx;
  background: currentColor;
  border-radius: 3rpx;
}

.day-barbell::before,
.day-barbell::after {
  content: '';
  position: absolute;
  top: -10rpx;
  width: 6rpx;
  height: 25rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.day-barbell::before { left: 6rpx; }
.day-barbell::after { right: 6rpx; }

.plan-row-title {
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-row-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-dim);
  line-height: 1.3;
}

.plan-row-tools {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

/* 强制重置微信 button 默认，避免 184px 挤压 */
.tool-btn,
.row-link,
.plan-card-delete-btn,
.all-plan-btn-enable,
.all-plan-btn-delete,
.edit-pill {
  max-width: none !important;
}

.tool-btn,
.row-link {
  box-sizing: border-box !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  border: none !important;
  background: transparent !important;
}

.tool-btn::after,
.row-link::after {
  display: none !important;
  border: none !important;
}

.tool-btn {
  width: 88rpx !important;
  height: 88rpx !important;
  min-width: 88rpx !important;
  min-height: 88rpx !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: var(--surface-2) !important;
  color: var(--ink-dim) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 14rpx !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
}

.tool-btn-hover {
  opacity: 0.75;
}

.tool-btn[disabled] {
  opacity: 0.28 !important;
  background: var(--surface-2) !important;
  color: var(--ink-faint) !important;
  border-color: var(--line) !important;
}

.tool-btn.danger {
  background: rgba(255, 143, 124, 0.08) !important;
  color: var(--danger) !important;
  border-color: rgba(255, 143, 124, 0.18) !important;
}

/* 编排入口：透明按钮，保留完整触控区。 */
.row-link {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 88rpx !important;
  min-height: 88rpx !important;
  padding: 12rpx 4rpx !important;
  white-space: nowrap;
  flex-shrink: 0;
}

.row-link-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--signal);
  line-height: 1;
}

.row-link-chevron {
  width: 10rpx;
  height: 10rpx;
  margin-top: -1rpx;
  border-top: 3rpx solid var(--signal);
  border-right: 3rpx solid var(--signal);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.row-link-hover {
  opacity: 0.78;
}

/* ===== 底部操作区 ===== */
button.primary-button,
button.ghost-button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 18rpx 24rpx !important;
  line-height: 1.4 !important;
  border-radius: 28rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  letter-spacing: 0;
  box-sizing: border-box !important;
}

button.primary-button {
  background: var(--signal-gradient) !important;
  box-shadow: var(--signal-glow);
  color: var(--signal-ink) !important;
}

button.ghost-button {
  color: var(--ink-dim) !important;
  border: 1rpx solid var(--signal-line) !important;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-row .action-btn {
  flex: 1 !important;
  width: auto !important;
  min-height: 100rpx !important;
  font-weight: 600 !important;
  letter-spacing: 0;
  background: var(--card-gradient) !important;
}

.page .block-btn {
  width: 100% !important;
  margin-top: 24rpx !important;
  min-height: 88rpx !important;
  font-weight: 600 !important;
  letter-spacing: 0;
  background: var(--surface) !important;
}

.ghost-press {
  opacity: 0.78;
}

.primary-press {
  opacity: 0.85;
}

.btn-press {
  opacity: 0.75;
}

/* ===== 全部计划切换列表 ===== */
.all-plans-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.all-plan-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 22rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
}

/* 当前计划：分层底色 */
.all-plan-item.active {
  border-color: var(--line-strong);
  background: var(--surface-2);
}

.all-plan-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--line-strong);
  margin-right: 18rpx;
  flex-shrink: 0;
}

.all-plan-status-dot.active {
  background: var(--signal);
}

.all-plan-info {
  flex: 1;
  min-width: 0;
}

.all-plan-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.all-plan-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
}

/* 当前使用徽标 */
.all-plan-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: var(--signal-ink);
  background: var(--signal);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  letter-spacing: 0.04em;
  white-space: nowrap;
  line-height: 1.3;
}

.all-plan-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-dim);
  line-height: 1.4;
}

.all-plan-meta .highlight {
  color: var(--ink);
  font-weight: 800;
}

.all-plan-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.all-plan-btn-enable {
  box-sizing: border-box !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 14rpx 26rpx !important;
  line-height: 1 !important;
  border: 1rpx solid var(--signal-line) !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: var(--signal-soft) !important;
  color: var(--signal) !important;
  border-radius: 16rpx !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  white-space: nowrap;
}

.all-plan-btn-enable::after {
  display: none !important;
  border: none !important;
}

.all-plan-btn-delete {
  box-sizing: border-box !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 14rpx 26rpx !important;
  line-height: 1 !important;
  border: 1rpx solid rgba(255, 143, 124, 0.2) !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: rgba(255, 143, 124, 0.08) !important;
  color: var(--danger) !important;
  border-radius: 16rpx !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  white-space: nowrap;
}

.all-plan-btn-delete::after {
  display: none !important;
  border: none !important;
}

/* ===== 空状态：沿用全局 + 本页微调 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 36rpx 80rpx;
  text-align: center;
}

.empty-state .empty-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 148rpx;
  border: 2rpx dashed var(--signal-line);
  border-radius: 50%;
  font-size: 56rpx;
  color: var(--signal);
  line-height: 1;
  background: var(--signal-soft);
}

.empty-state .empty-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.empty-state .empty-desc {
  margin-top: 12rpx;
  max-width: 480rpx;
  font-size: var(--t-meta);
  color: var(--ink-dim);
  line-height: 1.55;
}

.empty-state .empty-btn {
  margin-top: 44rpx !important;
  width: 72% !important;
  max-width: 420rpx;
  min-height: 96rpx !important;
  letter-spacing: 0;
}

/* 小胶囊视觉不变，透明外扩到至少 88rpx 高的触控区域。 */
.edit-pill::before,
.plan-card-delete-btn::before,
.all-plan-btn-enable::before,
.all-plan-btn-delete::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.plan-card-delete-btn,
.all-plan-btn-enable,
.all-plan-btn-delete {
  position: relative;
  min-width: 88rpx !important;
}

.plan-row-main,
.all-plan-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 88rpx;
}
