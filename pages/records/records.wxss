.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

.archive-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.archive-header .page-title { font-size: 48rpx; }
.sync-status { color: var(--signal); font-size: 23rpx; white-space: nowrap; }
.sync-status.pending { color: var(--amber); }

/* ===== 分段胶囊 ===== */
.record-tabs {
  display: flex;
  gap: 8rpx;
  margin: 24rpx 0 20rpx;
  padding: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: 22rpx;
}

.record-tab {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0 !important;
  min-height: 88rpx;
  margin: 0 !important;
  flex: 1;
  padding: 16rpx 12rpx !important;
  line-height: 1.4 !important;
  background: transparent !important;
  color: var(--ink-faint) !important;
  font-size: var(--t-body) !important;
  border-radius: 20rpx !important;
  border: 1rpx solid transparent !important;
}

.record-tab.active {
  color: var(--signal) !important;
  background: var(--signal-soft) !important;
  border-color: var(--signal-line) !important;
  font-weight: 800;
}

/* ===== 独立场次卡片 ===== */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 128rpx;
  padding: 18rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
}

.record-date {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 20rpx;
}

.record-day {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.record-month {
  margin-top: 8rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 28rpx;
  font-weight: 700;
}

.record-meta {
  margin-top: 4rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.record-volume {
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--t-meta);
  font-weight: 700;
  color: var(--signal);
  max-width: 160rpx;
  overflow-wrap: break-word;
  text-align: right;
}

/* ===== 趋势图 ===== */
.metric-btn {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 16rpx 22rpx !important;
  line-height: 1.4 !important;
  background: var(--signal-soft) !important;
  color: var(--signal) !important;
  border: 1rpx solid var(--signal-line) !important;
  border-radius: 999rpx !important;
  font-size: var(--t-kicker) !important;
}

.chart-wrap {
  padding: 20rpx 26rpx 26rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: var(--card-shadow);
}

.chart-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx 16rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 800;
}

.chart-sub {
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.chart {
  position: relative;
  height: 220rpx;
  margin-top: 76rpx;
  margin-bottom: 44rpx;
  margin-left: 56rpx;
  border-left: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
}

.chart-bars {
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 16rpx;
  padding: 0 18rpx;
}

.chart-bar {
  position: relative;
  flex: 1;
  max-width: 64rpx;
  background: var(--signal-gradient);
  opacity: 0.72;
  box-shadow: var(--signal-glow);
  border-radius: 8rpx 8rpx 0 0;
}

.chart-bar.last {
  background: var(--signal-gradient);
  opacity: 1;
  border-top: 2rpx solid var(--signal);
  box-shadow: var(--signal-glow);
}

.bar-value {
  position: absolute;
  top: -38rpx;
  left: 50%;
  transform: translateX(-50%);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 18rpx;
  color: var(--ink-faint);
  white-space: nowrap;
}

.bar-label {
  position: absolute;
  bottom: -44rpx;
  left: 50%;
  transform: translateX(-50%);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 18rpx;
  color: var(--ink-faint);
}

.record-footnote {
  margin-top: 32rpx;
  color: var(--ink-faint);
  font-size: var(--t-kicker);
  line-height: 1.6;
}

/* ===== 指标切换弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.64);
}

.sheet-card {
  width: 100%;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--surface);
  border-top: 1rpx solid var(--signal-line);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: var(--card-shadow);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.sheet-option {
  display: block !important;
  width: 100% !important;
  min-width: 0 !important;
  margin: 12rpx 0 0 !important;
  padding: 24rpx !important;
  line-height: 1.4 !important;
  background: var(--surface-2) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 20rpx !important;
  text-align: left;
  font-size: var(--t-body) !important;
  color: var(--ink-dim) !important;
}

.sheet-option.active {
  background: var(--signal-soft) !important;
  border-color: var(--signal-line) !important;
  color: var(--signal) !important;
  font-weight: 700;
}

.record-tab::after,
.metric-btn::after,
.sheet-option::after {
  display: none !important;
}

/* 纯装饰方向提示，不增加文案或交互。 */
.record-item::after {
  content: '';
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid var(--signal);
  border-right: 2rpx solid var(--signal);
  transform: rotate(45deg);
}

.chart-bar.last .bar-value,
.chart-bar.last .bar-label {
  color: var(--ink);
  font-weight: 800;
}

.empty-state {
  margin-top: 24rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  box-shadow: var(--card-shadow);
}

.empty-state .empty-glyph {
  background: var(--signal-soft);
  border-color: var(--signal-line);
  box-shadow: var(--signal-glow);
}

/* Board 02: compact stats, chart scale and recent timeline. */
.stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-bottom: 20rpx; }
.stat-card { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 26rpx 8rpx 20rpx; background: var(--card-gradient); border: 1rpx solid var(--line-strong); border-radius: 24rpx; }
.stat-label { margin-top: 14rpx; color: var(--ink-dim); font-size: 24rpx; }
.stat-number { font-size: 40rpx; font-weight: 800; line-height: 1.4; white-space: nowrap; }
.stat-number text { font-size: 24rpx; font-weight: 500; }
.stat-icon { position: relative; width: 34rpx; height: 34rpx; color: var(--signal); }
.icon-calendar { border: 3rpx solid var(--signal); border-radius: 6rpx; height: 32rpx; margin-top: 2rpx; }
.icon-calendar::before { content: ''; position: absolute; left: 4rpx; right: 4rpx; top: -7rpx; height: 10rpx; border-left: 4rpx solid var(--signal); border-right: 4rpx solid var(--signal); }
.icon-calendar::after { content: ''; position: absolute; top: 7rpx; left: 0; right: 0; border-top: 2rpx solid var(--signal); }
.icon-weight { border-left: 9rpx solid var(--signal); border-right: 9rpx solid var(--signal); border-radius: 5rpx; height: 24rpx; margin: 5rpx 0; }
.icon-weight::before { content: ''; position: absolute; left: -6rpx; right: -6rpx; top: 10rpx; height: 4rpx; background: var(--signal); }
.icon-flame { width: 26rpx; height: 34rpx; background: var(--signal-gradient); border-radius: 75% 5% 65% 60%; transform: rotate(-30deg); }
.icon-flame::after { content: ''; position: absolute; bottom: 0; right: 5rpx; height: 17rpx; width: 10rpx; border-radius: 70% 5% 65% 60%; background: var(--surface); }
.chart-heading-row { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 8rpx; }
.chart-heading-row picker { flex: 1; min-width: 0; margin: -16rpx 0; padding: 16rpx 0; }
.chart-title { min-height: 56rpx; display: flex; align-items: center; line-height: 1.3; }
.picker-arrow { color: var(--ink-faint); font-size: 20rpx; margin-left: 8rpx; }
.metric-btn { position: relative; }
.metric-btn::before { content: ''; position: absolute; inset: -20rpx 0; min-height: 88rpx; }
.chart-tick { position: absolute; left: 0; right: 0; border-top: 1rpx solid var(--line); pointer-events: none; }
.tick-label { position: absolute; right: 100%; padding-right: 14rpx; transform: translateY(-50%); color: var(--ink-faint); font-size: 20rpx; }
.pr-badge { position: absolute; top: -74rpx; left: 50%; transform: translateX(-50%); padding: 0 12rpx; border-radius: 12rpx; background: var(--signal-gradient); box-shadow: var(--signal-glow); color: var(--signal-ink); font-size: 20rpx; font-weight: 800; }
.recent-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.recent-heading .section-kicker { margin: 0; }
.view-all { display: flex; align-items: center; justify-content: flex-end; min-height: 88rpx; min-width: 148rpx; margin: 0; color: var(--ink-faint); font-size: 22rpx; }

.chart-empty { padding: 48rpx 0 24rpx; }
