.page {
  min-height: 100vh;
  padding: 30rpx 32rpx 48rpx;
  background: var(--bg);
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.topline-hint {
  color: var(--signal);
}

/* ===== 视图切换:下划线式 ===== */
.record-tabs {
  display: flex;
  gap: 44rpx;
  margin: 36rpx 0 8rpx;
}

.record-tab {
  padding: 0 0 16rpx;
  color: var(--ink-faint);
  font-size: var(--t-body);
  border-bottom: 4rpx solid transparent;
}

.record-tab.active {
  color: var(--ink);
  border-bottom-color: var(--signal);
  font-weight: 800;
}

/* ===== 场次时间线:大日期 + 细线 ===== */
.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 150rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.record-date {
  display: flex;
  flex-direction: column;
  width: 96rpx;
}

.record-day {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.record-month {
  margin-top: 8rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
}

.record-meta {
  margin-top: 4rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.record-volume {
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--t-meta);
  font-weight: 700;
  color: var(--signal);
  white-space: nowrap;
}

/* ===== 趋势图 ===== */
.trend-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  margin: 22rpx 0 30rpx;
}

.picker-box {
  padding: 16rpx 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: var(--t-body);
  font-weight: 700;
}

.metric-btn {
  padding: 16rpx 22rpx;
  color: var(--signal);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-size: var(--t-kicker);
}

.chart-wrap {
  padding: 32rpx 26rpx 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.chart-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.chart-title {
  font-size: 36rpx;
  font-weight: 800;
}

.chart-sub {
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.chart {
  position: relative;
  height: 320rpx;
  margin-top: 30rpx;
  border-left: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
}

.chart-bars {
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 16rpx;
  padding: 0 18rpx;
}

.chart-bar {
  position: relative;
  flex: 1;
  max-width: 64rpx;
  background: linear-gradient(180deg, rgba(22, 191, 174, 0.95) 0%, rgba(22, 191, 174, 0.35) 100%);
  border-radius: 8rpx 8rpx 0 0;
}

.chart-bar.last {
  background: linear-gradient(180deg, rgba(255, 216, 74, 0.98) 0%, rgba(255, 216, 74, 0.45) 100%);
}

.bar-value {
  position: absolute;
  top: -38rpx;
  left: 50%;
  transform: translateX(-50%);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 18rpx;
  color: var(--ink-faint);
  white-space: nowrap;
}

.bar-label {
  position: absolute;
  bottom: -44rpx;
  left: 50%;
  transform: translateX(-50%);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 18rpx;
  color: var(--ink-faint);
}

.record-footnote {
  margin-top: 80rpx;
  color: var(--ink-faint);
  font-size: var(--t-kicker);
  line-height: 1.6;
}

/* ===== 指标切换弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 29, 26, 0.48);
}

.sheet-card {
  width: 100%;
  padding: 44rpx 44rpx 64rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.sheet-option {
  display: block;
  width: 100%;
  padding: 28rpx 0;
  text-align: left;
  font-size: var(--t-body);
  color: var(--ink-dim);
  border-bottom: 1rpx solid var(--line);
}

.sheet-option.active {
  color: var(--signal);
  font-weight: 700;
}
