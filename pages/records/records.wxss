.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

.topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.topline-hint {
  color: var(--signal);
}

/* ===== 视图切换:下划线式 ===== */
.record-tabs {
  display: flex;
  gap: 44rpx;
  margin: 36rpx 0 8rpx;
}

.record-tab {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 0 0 16rpx !important;
  line-height: 1.4 !important;
  background: transparent !important;
  color: var(--ink-faint) !important;
  font-size: var(--t-body) !important;
  border-radius: 0 !important;
  border-bottom: 4rpx solid transparent !important;
}

.record-tab.active {
  color: var(--ink) !important;
  border-bottom-color: var(--signal) !important;
  font-weight: 800;
}

/* ===== 场次时间线:大日期 + 细线 ===== */
.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 150rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.record-date {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  width: 96rpx;
}

.record-day {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.record-month {
  margin-top: 8rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
}

.record-meta {
  margin-top: 4rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.record-volume {
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--t-meta);
  font-weight: 700;
  color: var(--signal);
  max-width: 180rpx;
  overflow-wrap: break-word;
  text-align: right;
}

/* ===== 趋势图 ===== */
.trend-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  margin: 22rpx 0 30rpx;
}

.trend-picker picker {
  flex: 1;
  min-width: 0;
  width: 0;
}

.picker-box {
  width: 100%;
  padding: 16rpx 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  font-size: var(--t-body);
  font-weight: 700;
}

.metric-btn {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 16rpx 22rpx !important;
  line-height: 1.4 !important;
  background: var(--surface-2) !important;
  color: var(--signal) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 16rpx !important;
  font-size: var(--t-kicker) !important;
}

.chart-wrap {
  padding: 32rpx 26rpx 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.chart-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.chart-title {
  font-size: 36rpx;
  font-weight: 800;
}

.chart-sub {
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.chart {
  position: relative;
  height: 320rpx;
  margin-top: 60rpx;
  margin-bottom: 44rpx;
  border-left: 1rpx solid var(--line-strong);
  border-bottom: 1rpx solid var(--line-strong);
}

.chart-bars {
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 16rpx;
  padding: 0 18rpx;
}

.chart-bar {
  position: relative;
  flex: 1;
  max-width: 64rpx;
  background: rgba(61, 220, 151, 0.55);
  border-radius: 8rpx 8rpx 0 0;
}

.chart-bar.last {
  background: var(--signal);
}

.bar-value {
  position: absolute;
  top: -38rpx;
  left: 50%;
  transform: translateX(-50%);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 18rpx;
  color: var(--ink-faint);
  white-space: nowrap;
}

.bar-label {
  position: absolute;
  bottom: -44rpx;
  left: 50%;
  transform: translateX(-50%);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 18rpx;
  color: var(--ink-faint);
}

.record-footnote {
  margin-top: 80rpx;
  color: var(--ink-faint);
  font-size: var(--t-kicker);
  line-height: 1.6;
}

/* ===== 指标切换弹层 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.64);
}

.sheet-card {
  width: 100%;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.sheet-option {
  display: block !important;
  width: 100% !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 24rpx 0 !important;
  line-height: 1.4 !important;
  background: transparent !important;
  border-radius: 0 !important;
  text-align: left;
  font-size: var(--t-body) !important;
  color: var(--ink-dim) !important;
  border-bottom: 1rpx solid var(--line) !important;
}

.sheet-option.active {
  color: var(--signal) !important;
  font-weight: 700;
}

.record-tab::after,
.metric-btn::after,
.sheet-option::after {
  display: none !important;
}
