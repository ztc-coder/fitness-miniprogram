<view class="training-page {{restActive ? 'has-rest' : ''}} {{showSummary ? 'show-summary' : ''}}">
  <block wx:if="{{!showSummary}}">
    <view class="session-toolbar">
      <text class="toolbar-label">本场训练</text>
      <view class="elapsed mono"><view class="clock-icon"></view>{{elapsedText}}</view>
      <button class="pause-button" wx:if="{{phase !== 'paused'}}" bindtap="onPause" disabled="{{reloadBlocked || submitting || confirming}}" aria-label="暂停训练"><view class="pause-icon"></view><text>暂停</text></button>
      <button class="pause-button" wx:else bindtap="onResume" disabled="{{reloadBlocked || submitting || confirming}}">继续</button>
    </view>
    <view class="paused-banner" wx:if="{{phase === 'paused'}}">训练已暂停 · 点击右上角继续</view>
    <view class="training-heading">
      <view class="training-title">{{session.dayName || '训练记录'}}</view>
      <view class="training-subtitle">{{session.planName}}<text wx:if="{{session.dayIndex !== undefined}}"> · 第 {{session.dayIndex + 1}} 天</text></view>
    </view>
    <view class="progress-section">
      <view class="progress-labels"><text>已完成 <text class="signal mono">{{progress.completed}}</text> / {{progress.total}} 组<text wx:if="{{progress.skipped}}"> · 跳过 {{progress.skipped}} 组</text></text><text class="signal">{{progress.pending === 0 && progress.completed ? '全部完成' : '稳稳完成每一组'}}</text></view>
      <view class="progress-track"><view class="progress-fill" style="width: {{progressPct}}%"></view></view>
    </view>
    <view class="save-error" wx:if="{{errorText}}" aria-role="alert">{{errorText}}<button wx:if="{{reloadBlocked}}" bindtap="onRetryDraft">重试读取草稿</button></view>
    <view class="rest-message" wx:if="{{restMessage}}">{{restMessage}}</view>

    <view class="exercise-list">
      <view class="ex-card {{ex.skipped ? 'is-skipped' : ''}}" wx:for="{{exercises}}" wx:key="anchorId" wx:for-item="ex">
        <view class="ex-header">
          <button class="ex-thumb" catchtap="onExerciseTap" data-ex="{{ex.exIndex}}" data-anchor-id="{{ex.anchorId}}" aria-label="查看{{ex.name}}动作要领" hover-class="pressed">
            <image wx:if="{{ex.thumbSrc}}" class="ex-thumb-img" src="{{ex.thumbSrc}}" mode="aspectFill" binderror="onThumbError" data-ex="{{ex.exIndex}}" />
            <text wx:else>{{ex.glyph}}</text>
          </button>
          <view class="ex-name-wrap"><view class="ex-name">{{ex.name}}</view><view class="ex-sub">{{ex.completedCount}} / {{ex.sets.length}} 组完成<text wx:if="{{ex.bodyPart}}"> · {{ex.bodyPart}}</text></view></view>
          <button class="btn-more" catchtap="onSkipExercise" data-anchor-id="{{ex.anchorId}}" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}" aria-label="{{ex.name}}更多操作">•••</button>
        </view>
        <view class="set-row set-header"><text class="col-num">组</text><text class="col-input">{{ex.isBodyWeight ? '额外负重 kg' : '重量 kg'}}</text><text class="col-input">次数</text><text class="col-check">完成</text><text class="col-delete"></text></view>
        <view class="set-row set-{{set.status}}" wx:for="{{ex.sets}}" wx:for-item="set" wx:key="setId">
          <text class="col-num mono">{{set.num}}</text>
          <view class="col-input">
            <input wx:if="{{set.status !== 'skipped'}}" class="set-input mono" type="digit" value="{{set.weight}}" placeholder="{{ex.isBodyWeight ? '0' : '—'}}" placeholder-class="input-placeholder" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}" data-set-id="{{set.setId}}" bindinput="onInputWeight" bindblur="onInputBlur" cursor-spacing="160" aria-label="{{ex.name}}第{{set.num}}组{{ex.isBodyWeight ? '额外负重' : '重量'}}" />
            <text wx:else class="skipped-value">—</text>
          </view>
          <view class="col-input">
            <input wx:if="{{set.status !== 'skipped'}}" class="set-input mono" type="number" value="{{set.reps}}" placeholder="—" placeholder-class="input-placeholder" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}" data-set-id="{{set.setId}}" bindinput="onInputReps" bindblur="onInputBlur" cursor-spacing="160" aria-label="{{ex.name}}第{{set.num}}组次数" />
            <text wx:else class="skipped-value">已跳过</text>
          </view>
          <button class="col-check check-button" bindtap="onToggleSet" data-set-id="{{set.setId}}" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused' || set.status === 'skipped'}}" aria-label="{{ex.name}}第{{set.num}}组{{set.status === 'completed' ? '取消完成' : '标记完成'}}" aria-role="checkbox" aria-checked="{{set.status === 'completed'}}"><view class="check-box"><view wx:if="{{set.status === 'completed'}}" class="check-mark"></view><text wx:if="{{set.status === 'skipped'}}">−</text></view></button>
          <button wx:if="{{set.canRemove}}" class="col-delete delete-button" catchtap="onRemoveSet" data-set-id="{{set.setId}}" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}" aria-label="删除{{ex.name}}第{{set.num}}组">−</button><view wx:else class="col-delete"></view>
        </view>
        <button class="add-set" bindtap="onAddSet" data-anchor-id="{{ex.anchorId}}" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">＋ 增加一组</button>
        <button class="rest-launch" wx:if="{{ex.completedCount && !restActive}}" bindtap="onStartRest" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}"><view class="clock-icon"></view><text>开始间歇</text><text class="mono">{{restSeconds}} 秒</text></button>
        <view wx:if="{{ex.skipped}}" class="skip-note">本动作已跳过，可在更多操作中恢复</view>
      </view>
      <view class="empty-state" wx:if="{{!exercises.length && !reloadBlocked}}"><view class="empty-title">从一个动作开始</view><view class="empty-desc">点击下方“加练动作”，添加今天想练的动作。</view></view>
    </view>
    <view class="media-credit" wx:if="{{exercises.length}}">© Gym visual</view>
    <view class="bottom-bar">
      <button wx:if="{{restActive}}" class="mini-timer" bindtap="onExpandRest" aria-label="展开组间间歇"><view class="clock-icon"></view><view class="mini-timer-body"><view class="mini-label">{{restPaused ? '间歇已暂停' : '组间休息'}}</view><view class="mini-time mono">{{restText}}</view></view><text class="mini-expand">展开⌄</text></button>
      <view class="bottom-actions"><button class="secondary-button" bindtap="onAddExercise" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">＋ 加练动作</button><button class="primary-button" bindtap="onFinish" disabled="{{reloadBlocked || !canFinish || submitting || confirming}}">{{submitting ? '保存中…' : '结束训练'}}</button></view>
    </view>
  </block>

  <view wx:if="{{showSummary}}" class="summary-page">
    <view class="success-symbol"><view class="check-mark"></view></view>
    <view class="summary-title">今天，练到了。</view>
    <view class="summary-subtitle">{{session.dayName}} · {{summary.date}}</view>
    <view class="summary-stats">
      <view class="summary-stat"><view class="stat-number mono">{{summary.duration}}</view><text class="stat-label">训练时长</text></view>
      <view class="summary-stat"><view><text class="stat-number mono">{{summary.completedSets}}</text><text class="stat-unit">组</text></view><text class="stat-label">实际完成</text></view>
      <view class="summary-stat"><view><text class="stat-number mono">{{summary.weightedVolume}}</text><text class="stat-unit">kg</text></view><text class="stat-label">负重训练容量</text></view>
      <view class="summary-stat"><view><text class="stat-number mono">{{summary.exerciseCount}}</text><text class="stat-unit">个</text></view><text class="stat-label">完成动作</text></view>
    </view>
    <view wx:if="{{summary.hasBodyWeight}}" class="bodyweight-stat"><text>自重动作总次数</text><text><text class="mono">{{summary.bodyWeightReps}}</text> 次</text></view>
    <view wx:if="{{summary.comparisons.length}}" class="comparison-card"><view class="comparison-caption">对比上次同训练日</view><view wx:for="{{summary.comparisons}}" wx:key="label" class="comparison-row"><text>{{item.label}}</text><text class="mono {{item.improved ? 'signal' : ''}}">{{item.diffText}}</text></view></view>
    <view class="recap-heading"><text>这次的积累</text><text class="recap-meta">{{summary.completedSets}} 组已记录</text></view>
    <view wx:for="{{summary.exercises}}" wx:key="key" class="recap-row"><view class="recap-name"><view>{{item.name}}</view><view class="recap-meta">{{item.completed}} 组完成</view></view><text class="recap-volume mono">{{item.volumeText}}</text></view>
    <view class="summary-saved">本次训练已保存</view>
    <view class="bottom-bar summary-bottom"><button class="primary-button" bindtap="onSummaryBackToday">回到今天</button><button class="text-button" bindtap="onSummaryViewRecords">查看训练记录</button></view>
  </view>

  <view wx:if="{{restExpanded && restActive && !showSummary}}" class="rest-backdrop" catchtouchmove="onBlockTouch">
    <view class="rest-sheet" role="dialog" aria-label="组间休息">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><view><view class="sheet-title">组间休息</view><view class="sheet-subtitle">调整呼吸，准备下一组。</view></view><button class="collapse-button" bindtap="onCollapseRest">收起⌄</button></view>
      <view class="timer-ring">
        <view class="ring-track"></view>
        <view class="ring-half ring-right"><view class="ring-arc" style="transform: rotate({{ringRight}}deg)"></view></view>
        <view class="ring-half ring-left"><view class="ring-arc" style="transform: rotate({{ringLeft}}deg)"></view></view>
        <view class="timer-center"><view class="rest-clock mono">{{restText}}</view><view class="clock-label">{{restPaused ? '计时已暂停' : '留一点时间，恢复力量'}}</view></view>
      </view>
      <view class="rest-presets"><button wx:for="{{restPresets}}" wx:key="*this" class="preset {{restSeconds === item ? 'selected' : ''}}" bindtap="onRestPreset" data-seconds="{{item}}" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">{{item}} 秒</button></view>
      <view class="rest-controls"><button bindtap="onAdjustRest" data-delta="-15" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">−15 秒</button><button class="pause-rest" wx:if="{{!restPaused}}" bindtap="onPauseRest" disabled="{{reloadBlocked || submitting || confirming}}">暂停计时</button><button class="pause-rest" wx:else bindtap="onResumeRest" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">继续计时</button><button bindtap="onAdjustRest" data-delta="15" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">＋15 秒</button></view>
      <button class="primary-button end-rest" bindtap="onSkipRest" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">结束休息</button>
      <button class="restart-rest" bindtap="onStartRest" disabled="{{reloadBlocked || submitting || confirming || phase === 'paused'}}">重新开始 {{restSeconds}} 秒</button>
      <view class="sheet-foot">{{phase === 'paused' ? '整场训练已暂停，收起后可继续训练' : '收起后可继续填写和勾选训练记录'}}</view>
    </view>
  </view>
  <exercise-detail wx:if="{{detail}}" detail="{{detail}}" show-pick="{{false}}" bind:close="onCloseDetail" />
</view>