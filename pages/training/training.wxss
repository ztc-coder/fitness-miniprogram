.training-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx;
  /* 为底部悬浮栏留出空间 */
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

button::after {
  display: none;
}
button {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: inherit;
  border-radius: 0;
}

/* --- 顶部精简状态栏 --- */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  margin-top: 16rpx;
  position: relative;
  z-index: 10;
}

.btn-pause {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--t-meta);
  color: var(--ink-dim);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  font-weight: 700;
  letter-spacing: 0.05em;
}

.icon-pause {
  font-size: 20rpx;
  font-weight: 900;
  transform: scaleY(1.2);
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  background: var(--surface);
  border-radius: 999rpx;
  font-size: var(--t-meta);
  color: var(--ink);
  box-shadow: 0 4rpx 16rpx rgba(21, 59, 58, 0.04);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--amber);
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: 0.6; }
  100% { transform: scale(1); opacity: 1; }
}

/* --- 开放式标题与进度 --- */
.header-section {
  position: relative;
  padding: 64rpx 0 48rpx;
}

.hero-day-mark {
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-size: 160rpx;
  font-weight: 900;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(21, 59, 58, 0.06);
  position: absolute;
  top: -20rpx;
  right: -32rpx;
  line-height: 1;
  pointer-events: none;
  z-index: 0;
  white-space: nowrap;
}

.header-section .page-title,
.header-section .page-subtitle {
  position: relative;
  z-index: 1;
}

.progress-section {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
}

.progress-kicker {
  font-size: var(--t-meta);
  color: var(--ink-faint);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.progress-val {
  font-size: 40rpx;
  color: var(--ink);
  font-weight: 900;
  line-height: 1;
}

.progress-track {
  height: 16rpx;
  background: rgba(21, 59, 58, 0.06);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--amber);
  border-radius: 999rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* --- 动作列表 --- */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  min-width: 0;
  width: 100%;
  position: relative;
  z-index: 1;
}

.ex-card {
  background: var(--surface);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(21, 59, 58, 0.03);
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.ex-card.is-skipped {
  opacity: 0.5;
  background: rgba(255, 255, 255, 0.4);
  box-shadow: none;
  border: 1rpx dashed var(--line-strong);
}

.ex-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.ex-info {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 24rpx;
}

.ex-index-mark {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--amber);
  line-height: 1.2;
}

.ex-name-wrap {
  flex: 1;
}

.ex-name {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--ink);
  word-break: break-all;
}

.ex-sub {
  font-size: var(--t-meta);
  color: var(--ink-dim);
  margin-top: 8rpx;
}

.btn-more {
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  min-height: 64rpx;
  max-height: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex: 0 0 64rpx;
  padding: 0;
  border: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.btn-more::after {
  border: 0;
}

.more-dot {
  width: 6rpx;
  height: 6rpx;
  min-width: 6rpx;
  min-height: 6rpx;
  flex: 0 0 6rpx;
  background: var(--ink-dim);
  border-radius: 50%;
}

/* 组数表格区 */
.ex-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.set-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--surface-2);
}

.set-row:last-of-type {
  border-bottom: none;
}

.set-header {
  font-size: var(--t-kicker);
  color: var(--ink-dim);
  padding: 0 8rpx 16rpx;
  border-bottom: none;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 700;
}

/* 列宽分配 */
.col-num {
  width: 64rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
}

.col-input {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
}

.col-action {
  width: 64rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
}

.set-num-badge {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  border-radius: 12rpx;
  font-size: var(--t-meta);
  font-weight: 800;
  color: var(--ink-dim);
}

.set-input {
  width: 100%;
  height: 64rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  box-sizing: border-box;
  padding: 0 8rpx;
  background: transparent;
  border-radius: 8rpx;
  transition: background 0.2s;
}

.set-input:focus {
  background: var(--surface-2);
}

.ph-color {
  color: var(--ink-faint);
  font-weight: 400;
}

.btn-del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--danger);
  border-radius: 12rpx;
  background: rgba(229, 83, 61, 0.1);
  opacity: 0.8;
}

.del-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.btn-add-set {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--t-meta);
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--ink-dim);
  background: transparent;
  border: 1rpx dashed var(--line-strong);
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.add-icon {
  font-size: 24rpx;
  font-weight: 900;
}

.ex-skipped-msg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--t-meta);
  color: var(--ink-faint);
  font-weight: 700;
  letter-spacing: 0.05em;
  padding-top: 24rpx;
}

.skip-icon {
  font-size: 24rpx;
}

.btn-add-ex {
  width: 100%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
  background: var(--surface);
  border: 2rpx solid rgba(22, 191, 174, 0.45);
  border-radius: 999rpx;
  margin-top: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(21, 59, 58, 0.06);
  transition: background 0.15s ease, opacity 0.15s ease;
}

.btn-add-ex:active {
  background: var(--surface-2);
  opacity: 0.82;
}

.add-ex-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44rpx;
  border-radius: 50%;
  color: var(--signal-ink);
  background: var(--signal);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

/* 空状态 */
.empty-area {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* --- 固定底栏 --- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 60%, rgba(223, 240, 235, 0));
  box-sizing: border-box;
  z-index: 100;
  pointer-events: none; /* Let gradient be click-through */
}

.bottom-bar button, .bottom-bar .offline-note {
  pointer-events: auto; /* Re-enable clicks for active elements */
}

.bottom-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.bottom-actions button {
  flex: 1;
  width: auto;
  min-width: 0;
}

.bottom-actions .btn-add-ex {
  margin-top: 0;
}

.offline-note {
  font-size: var(--t-meta);
  color: var(--ink-dim);
  background: rgba(255, 216, 74, 0.4);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
  text-align: center;
  backdrop-filter: blur(8px);
}

/* --- 弹窗 --- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(21, 59, 58, 0.6);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  backdrop-filter: blur(12px);
}

.modal-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--surface);
  border-radius: 40rpx;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  box-shadow: 0 40rpx 80rpx rgba(21, 59, 58, 0.15);
}

.modal-kicker {
  font-size: var(--t-kicker);
  color: var(--signal);
  font-weight: 800;
  letter-spacing: 0.15em;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-kicker::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--signal);
}

.modal-subtitle {
  font-size: var(--t-body);
  color: var(--ink-dim);
  margin-top: 16rpx;
  line-height: 1.6;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
  margin: 56rpx 0;
}

.stat-item {
  flex: 1;
  background: var(--surface-2);
  padding: 32rpx 16rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-val {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: var(--t-meta);
  color: var(--ink-dim);
  font-weight: 700;
  letter-spacing: 0.05em;
}

.compare-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--t-meta);
  font-weight: 700;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  margin-bottom: 56rpx;
}

.compare-icon {
  font-size: 28rpx;
  font-weight: 900;
}

.compare-card.improved {
  color: #0d8a7d;
  background: rgba(22, 191, 174, 0.1);
}

.compare-card.declined {
  color: var(--danger);
  background: rgba(229, 83, 61, 0.1);
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.modal-actions .ghost-button {
  border: none;
  background: var(--surface-2);
  font-weight: 700;
}
