.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

.kicker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: var(--ink);
  font-size: var(--t-kicker);
  font-weight: 700;
  letter-spacing: 0;
  margin-bottom: 14rpx;
}

.kicker::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--signal);
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 32rpx;
}

.metric {
  min-width: 0;
  padding: 24rpx 18rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  display: flex;
  flex-direction: column;
}

.metric-num {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 38rpx;
  color: var(--signal);
  overflow-wrap: break-word;
  font-weight: 700;
}

.metric-label {
  margin-top: 6rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.exercise-card {
  margin-bottom: 16rpx;
  padding: 26rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  box-shadow: var(--card-shadow);
}

.exercise-card.skipped {
  background: var(--surface);
  border-style: dashed;
}

.exercise-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.exercise-name {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  font-size: 30rpx;
  font-weight: 700;
}

.exercise-volume {
  flex-shrink: 0;
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--t-meta);
  font-weight: 700;
  color: var(--signal);
}

.set-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.set-chip {
  padding: 10rpx 18rpx;
  background: var(--signal-soft);
  border: 1rpx solid var(--signal-line);
  border-radius: 16rpx;
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--t-kicker);
  color: var(--signal);
}

.skipped-note {
  margin-top: 12rpx;
  font-size: var(--t-kicker);
  color: var(--ink-faint);
}

.note-card {
  margin-top: 32rpx;
  border-radius: 28rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
}

/* 与档案统计一致：浅色合计用炭黑，组成绩仍以深绿和浅绿承接。 */
.theme-light .metric-num { color: var(--ink); }
