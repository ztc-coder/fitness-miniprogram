.page {
  min-height: 100vh;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
  color: var(--ink);
  font-size: var(--t-body);
  line-height: 1.7;
  overflow-wrap: break-word;
}
.card, .notice {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
}
.notice { border-color: var(--amber); }
.card-title { font-size: var(--t-card); font-weight: 700; margin-bottom: 16rpx; }
.paragraph + .paragraph { margin-top: 20rpx; }
.paragraph, .contact-label { color: var(--ink-dim); }
.contact-label { margin-top: 24rpx; }
.missing { margin-top: 12rpx; font-size: var(--t-meta); }
.page .contact-button {
  margin: 16rpx 0;
  min-height: 88rpx;
  font-size: var(--t-body);
  background: var(--surface-2);
  color: var(--ink);
  border: 1rpx solid var(--line-strong);
}
.page .contact-button[disabled] { color: var(--ink-faint); }
