/* FORGE：全站深墨绿、清晰成绩数字与信号绿行动，原生页面共享同一色板。 */
page {
  /* color */
  --bg: #0c1613;
  --surface: #14211c;
  --surface-2: #22352b;
  --line: #2a3b32;
  --line-strong: #3c5144;
  --ink: #eef5f1;
  --ink-dim: #a2b5aa;
  --ink-faint: #91a89a;
  --signal: #3ddc97;
  --signal-ink: #092518;
  --amber: #ffb020;
  --danger: #ff8f7c;

  /* type scale(rpx) */
  --t-hero: 128rpx;
  --t-title: 64rpx;
  --t-card: 34rpx;
  --t-body: 28rpx;
  --t-meta: 22rpx;
  --t-kicker: 20rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: var(--t-body);
  line-height: 1.6;
}

view, text, button, input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font: inherit;
  line-height: inherit;
  color: inherit;
}

button::after {
  border: 0;
}

/* ===== 数字/数据统一等宽 ===== */
.mono {
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-variant-numeric: tabular-nums;
}

/* ===== 通用排版 ===== */
.page-title {
  font-size: var(--t-title);
  font-weight: 800;
  letter-spacing: 0.02em;
  line-height: 1.12;
  color: var(--ink);
}

.page-subtitle {
  margin-top: 10rpx;
  font-size: var(--t-meta);
  color: var(--ink-dim);
}

/* 区块标:信号绿短线 + 大写字距 */
.section-kicker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 52rpx 0 22rpx;
  font-size: var(--t-kicker);
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--ink-faint);
}

.section-kicker::before {
  content: '';
  width: 24rpx;
  height: 4rpx;
  background: var(--signal);
}

/* ===== 通用按钮 ===== */
.primary-button.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 104rpx;
  padding: 18rpx 28rpx;
  color: var(--signal-ink);
  background: var(--signal);
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0;
  margin: 0;
  line-height: 1.4;
  transition: opacity 0.15s ease;
}

.primary-button:active {
  opacity: 0.82;
}

.ghost-button.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 14rpx 24rpx;
  color: var(--ink-dim);
  background: transparent;
  border: 1rpx solid var(--line-strong);
  width: 100%;
  margin: 0;
  line-height: 1.4;
  border-radius: 24rpx;
  font-size: var(--t-meta);
}

.ghost-button:active {
  opacity: 0.7;
}

/* ===== 空状态:虚线环徽标 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-state .empty-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: 50%;
  font-size: 52rpx;
  color: var(--signal);
  line-height: 1;
}

.empty-state .empty-title {
  margin-top: 30rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-state .empty-desc {
  margin-top: 10rpx;
  font-size: var(--t-meta);
  color: var(--ink-dim);
}

/* ===== 备注提示 ===== */
.note-card {
  padding: 24rpx;
  color: var(--ink-dim);
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  font-size: var(--t-kicker);
  line-height: 1.6;
}
