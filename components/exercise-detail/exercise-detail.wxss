@import "../../styles/theme.wxss";

/* ============================================================
   动作详情弹层 —— FORGE 深色设计，共享 v3 色板与组件基础排版
   卡片三段式布局,三段边界明确:
     1. .detail-head    标题区:高度由内容决定,不参与收缩
     2. .detail-scroll  正文区:吸收剩余高度,内容过长时收缩并可滚动
     3. .detail-actions 操作区:滚动区的兄弟节点,只在 showPick=true 时渲染
   两种状态:
     .has-actions(showPick=true)  卡片取确定高度,正文区吃满剩余高度,
                                 原生 scroll-view 因此有确定高度可滚(微信竖向滚动要求确定 height)
     只读态(showPick=false)       卡片按内容自适应,只受 max-height 约束,不留按钮空白
   ============================================================ */

.detail-mask {
  /* 自定义属性沿页面继承，组件仅保留独立基础排版。 */
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--overlay, rgba(0, 0, 0, 0.68));
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  box-sizing: border-box;
}

.detail-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640rpx;
  max-height: 82vh;
  padding: 36rpx 32rpx;
  background: var(--card-gradient);
  border: 1rpx solid var(--line-strong);
  border-radius: 32rpx;
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
}

/* 有操作区时给卡片一个确定高度:正文区才能用“剩余高度”这个确定值撑开 scroll-view。
   height 由 82vh 决定;max-height 再按视口减去遮罩上下内边距与底部安全区兜底,
   保证窄屏或带 home indicator 的机型上卡片仍落在屏内。 */
.detail-card.has-actions {
  height: 82vh;
  max-height: calc(100vh - 72rpx - env(safe-area-inset-bottom));
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  flex-shrink: 0;
}

.detail-head-main {
  flex: 1;
  min-width: 0;
}

.detail-kicker {
  display: inline-flex;
  padding: 5rpx 12rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 8rpx;
  color: var(--ink-dim);
  font-size: var(--t-kicker);
  font-weight: 800;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.detail-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  color: var(--ink);
  word-break: break-all;
}

.detail-close {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 72rpx !important;
  height: 72rpx !important;
  min-width: 72rpx !important;
  max-width: 72rpx !important;
  min-height: 72rpx !important;
  max-height: 72rpx !important;
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 !important;
  color: var(--ink-dim) !important;
  background: var(--surface-2) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 20rpx !important;
  font-size: 36rpx !important;
  line-height: 1 !important;
  box-sizing: border-box !important;
}

.detail-close::after {
  display: none !important;
  border: none !important;
}

.detail-close-hover {
  opacity: 0.75;
  background: var(--line) !important;
}

/* 正文区:只读态按内容自适应(flex-basis auto),卡片限高由 .detail-card 负责。
   这里不另设 max-height —— 否则只读详情会被过早截断。 */
.detail-scroll {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: 28rpx;
}

/* 有操作区:卡片高度已确定,正文区改成吃满剩余高度 —— flex-basis 0 + height 0
   让原生 scroll-view 拿到确定高度(而不是靠内容撑高),滚到底能看到末尾要领/备注/署名。 */
.detail-card.has-actions .detail-scroll {
  flex: 1 1 0%;
  height: 0;
}

.detail-art-wrap {
  margin-bottom: 24rpx;
  background: var(--thumb-gradient);
  border-radius: 28rpx;
  overflow: hidden;
}

.detail-media {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto;
  display: block;
  background: transparent;
  mix-blend-mode: multiply;
  border: 1rpx solid var(--line-strong);
  border-radius: 28rpx;
  box-sizing: border-box;
}

.detail-art {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  background: var(--thumb-gradient);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  color: var(--signal-ink);
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.detail-body {
  margin-bottom: 8rpx;
}

.detail-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.detail-info-label {
  font-size: 22rpx;
  color: var(--ink-faint);
  font-weight: 700;
  letter-spacing: 0.05em;
  flex-shrink: 0;
}

.detail-info-value {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 800;
  line-height: 1.3;
}

.detail-steps {
  margin-top: 6rpx;
}

.detail-steps-title {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.detail-steps-title::before {
  content: '';
  width: 5rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--signal);
  box-shadow: var(--signal-glow);
}

.detail-step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}

.detail-step-index {
  flex-shrink: 0;
  min-width: 40rpx;
  padding: 4rpx;
  background: var(--surface-2);
  border-radius: 12rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  color: var(--signal);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.6;
}

.detail-step-text {
  flex: 1;
  color: var(--ink-dim);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.detail-note {
  margin-top: 8rpx;
  padding: 16rpx 22rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 14rpx;
  color: var(--ink-dim);
  font-size: 22rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.detail-attribution {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 0.02em;
  line-height: 1.6;
  word-break: break-all;
}

/* 正文末尾留白:滚到底时署名与操作区分隔线之间保留可见间隔 */
.detail-tail-space {
  height: 16rpx;
}

/* 操作区:顶部一条分隔线划出边界;不定位、无负边距,与滚动区互为兄弟节点。
   背景取卡片底色,正文内容不会透到按钮上。
   showPick=false 时整块不渲染,打卡页只读详情不留按钮空白。 */
.detail-actions {
  flex-shrink: 0;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  background: transparent;
}

.detail-primary {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
  min-height: 96rpx !important;
  margin: 0 !important;
  padding: 18rpx 28rpx !important;
  color: var(--action-ink, var(--signal-ink)) !important;
  background: var(--action-background, var(--signal-gradient)) !important;
  border: none !important;
  border-radius: 28rpx !important;
  font-family: inherit;
  font-size: 30rpx !important;
  font-weight: 800;
  line-height: 1.4 !important;
  letter-spacing: 0.02em;
  white-space: normal;
  box-shadow: var(--signal-glow) !important;
  box-sizing: border-box !important;
}

.detail-primary::after {
  display: none !important;
  border: none !important;
}

.detail-primary-hover {
  opacity: 0.82;
}

.theme-light .detail-media {
  background: #FFFFFF;
  mix-blend-mode: normal;
}
.theme-light .detail-art-wrap.has-media {
  background: #FFFFFF;
}
