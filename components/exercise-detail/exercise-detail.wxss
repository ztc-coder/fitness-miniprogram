/* ============================================================
   动作详情弹层 —— 与动作库页同源设计(青色 kicker + 琥珀 glyph)
   卡片限高,正文 scroll-view 滚动,操作按钮钉底
   ============================================================ */

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: rgba(21, 59, 58, 0.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  box-sizing: border-box;
}

.detail-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640rpx;
  max-height: 82vh;
  padding: 36rpx 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 64rpx rgba(21, 59, 58, 0.18);
  box-sizing: border-box;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  flex-shrink: 0;
}

.detail-head-main {
  flex: 1;
  min-width: 0;
}

.detail-kicker {
  color: var(--signal);
  font-size: var(--t-kicker);
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  line-height: 1.3;
}

.detail-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  color: var(--ink);
  word-break: break-all;
}

.detail-subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-dim);
  line-height: 1.4;
  word-break: break-all;
}

.detail-close {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 72rpx !important;
  height: 72rpx !important;
  min-width: 72rpx !important;
  max-width: 72rpx !important;
  min-height: 72rpx !important;
  max-height: 72rpx !important;
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 !important;
  color: var(--ink-dim) !important;
  background: var(--surface-2) !important;
  border: 1rpx solid var(--line-strong) !important;
  border-radius: 50% !important;
  font-size: 36rpx !important;
  line-height: 1 !important;
  box-sizing: border-box !important;
}

.detail-close::after {
  display: none !important;
  border: none !important;
}

.detail-close-hover {
  opacity: 0.75;
  background: var(--line) !important;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 28rpx;
}

.detail-art-wrap {
  margin-bottom: 24rpx;
}

.detail-media {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto;
  display: block;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.detail-art {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  background: linear-gradient(145deg, rgba(22, 191, 174, 0.14), rgba(255, 216, 74, 0.12));
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  color: var(--ink);
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.detail-body {
  margin-bottom: 8rpx;
}

.detail-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.detail-info-label {
  font-size: 22rpx;
  color: var(--ink-faint);
  font-weight: 700;
  letter-spacing: 0.05em;
  flex-shrink: 0;
}

.detail-info-value {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 800;
  line-height: 1.3;
}

.detail-steps {
  margin-top: 6rpx;
}

.detail-steps-title {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--ink-faint);
  margin-bottom: 6rpx;
}

.detail-step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}

.detail-step-index {
  flex-shrink: 0;
  min-width: 34rpx;
  color: var(--signal);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.6;
}

.detail-step-text {
  flex: 1;
  color: var(--ink-dim);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.detail-note {
  margin-top: 8rpx;
  padding: 16rpx 22rpx;
  background: rgba(255, 216, 74, 0.16);
  border: 1rpx dashed rgba(217, 200, 121, 0.9);
  border-radius: 14rpx;
  color: var(--ink-dim);
  font-size: 22rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.detail-attribution {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 0.02em;
}

.detail-actions {
  margin-top: 28rpx;
  flex-shrink: 0;
}

.detail-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  padding: 18rpx 28rpx;
  color: var(--signal-ink);
  background: var(--signal);
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.1em;
  box-shadow: none;
  box-sizing: border-box;
}

.detail-primary::after {
  display: none;
  border: none;
}

.detail-primary-hover {
  opacity: 0.82;
}
