<!-- catchtouchmove:阻断触摸移动冒泡到页面,锁住遮罩下滚动;scroll-view 原生滚动不受影响 -->
<!-- 布局契约:标题区 / 正文滚动区 / 操作区依次为兄弟节点,操作区不在滚动区内 -->
<!-- showPick=true 时卡片加 .has-actions:卡片取确定高度,正文区才能吃满剩余高度并滚动 -->
<view class="detail-mask" wx:if="{{detail}}" bindtap="onClose" catchtouchmove="noop">
  <view class="detail-card {{showPick ? 'has-actions' : ''}}" catchtap="noop">
    <view class="detail-head">
      <view class="detail-head-main">
        <view class="detail-kicker">{{detail.equipmentZh}}</view>
        <view class="detail-title">{{detail.nameZh}}</view>
      </view>
      <button class="detail-close" bindtap="onClose" aria-label="关闭" hover-class="detail-close-hover">×</button>
    </view>

    <scroll-view class="detail-scroll" scroll-y>
      <!-- 媒体降级链:GIF → 示意图 → glyph;前缀未配置时级联为空,直接 glyph -->
      <view class="detail-art-wrap">
        <image
          wx:if="{{stageIndex < mediaStages.length}}"
          class="detail-media"
          src="{{mediaStages[stageIndex]}}"
          mode="aspectFit"
          binderror="onMediaError"
        />
        <view wx:else class="detail-art">{{detail.glyph}}</view>
      </view>

      <view class="detail-body">
        <view class="detail-info-row">
          <text class="detail-info-label">目标肌群</text>
          <text class="detail-info-value">{{detail.targetZh}}</text>
        </view>
        <view class="detail-info-row">
          <text class="detail-info-label">部位</text>
          <text class="detail-info-value">{{detail.bodyPartZh}}</text>
        </view>

        <view wx:if="{{detail.steps.length}}" class="detail-steps">
          <view class="detail-steps-title">动作要领</view>
          <view class="detail-step" wx:for="{{detail.steps}}" wx:key="*this">
            <text class="detail-step-index">{{index + 1}}</text>
            <text class="detail-step-text">{{item}}</text>
          </view>
        </view>

        <view wx:if="{{detail.isBodyWeight}}" class="detail-note">
          自重动作,容量按总次数统计,weight 记额外负重。
        </view>
      </view>

      <view class="detail-attribution">© Gym visual — https://gymvisual.com/</view>
      <!-- 末尾留白:只在有操作区时占位,保证滚到底时署名完整可见;打卡页只读详情不留空白 -->
      <view wx:if="{{showPick}}" class="detail-tail-space"></view>
    </scroll-view>

    <view class="detail-actions" wx:if="{{showPick}}">
      <button class="detail-primary" bindtap="onPick" hover-class="detail-primary-hover">{{pickText}}</button>
    </view>
  </view>
</view>
